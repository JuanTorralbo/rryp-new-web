---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary, LOCALE_LABELS, LOCALES, localizedPath, type Locale } from "../i18n";

const t = getDictionary("en");

const copyByLang = Object.fromEntries(
  LOCALES.map((loc: Locale) => {
    const d = getDictionary(loc);
    return [
      loc,
      {
        title: d.notFoundTitle,
        eyebrow: d.notFoundEyebrow,
        heading: d.notFoundHeading,
        lead: d.notFoundLead,
        homeBtn: d.notFoundHomeBtn,
        searchBtn: d.notFoundSearchBtn,
        homeUrl: localizedPath(loc),
      },
    ];
  })
);
---

<BaseLayout
  lang="en"
  slug=""
  title={t.notFoundTitle}
  description={t.notFoundLead}
  noindex={true}
>
  <section class="subhero">
    <div class="container">
      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim" id="nf-eyebrow">{t.notFoundEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" id="nf-heading">{t.notFoundHeading}</h1>
          <p class="hero-lead hero-anim hero-anim--d2" id="nf-lead">{t.notFoundLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={localizedPath("en")} class="btn btn--lime" id="nf-home-btn">{t.notFoundHomeBtn}</a>
            <button type="button" class="btn btn--outline-dark" id="nf-search-btn">{t.notFoundSearchBtn}</button>
          </div>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d4">
          <p class="subhero-aside-label">RRYP Global</p>
          <div class="footer-links" style="margin-top: 10px;">
            {LOCALES.map((loc) => (
              <div style="margin-bottom: 8px;">
                <a href={localizedPath(loc)} hreflang={loc} data-set-lang={loc}>
                  /{loc}/ {LOCALE_LABELS[loc].native} →
                </a>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script id="nf-i18n-data" type="application/json" set:html={JSON.stringify(copyByLang)} />

<script is:inline>
  (function () {
    var dataEl = document.getElementById("nf-i18n-data");
    var searchBtn = document.getElementById("nf-search-btn");
    if (searchBtn) {
      searchBtn.addEventListener("click", function () {
        if (typeof window.RRYP_OPEN_SEARCH === "function") window.RRYP_OPEN_SEARCH();
      });
    }
    if (!dataEl) return;
    var map = JSON.parse(dataEl.textContent || "{}");
    var seg = (window.location.pathname.split("/")[1] || "").toLowerCase();
    var cookieMatch = document.cookie.match(/(?:^|;\s*)rryp_lang=([^;]+)/);
    var savedLang = cookieMatch ? decodeURIComponent(cookieMatch[1]).toLowerCase() : "";
    var browserLang = (navigator.language || "en").slice(0, 2).toLowerCase();
    var lang = map[seg] ? seg : map[savedLang] ? savedLang : map[browserLang] ? browserLang : "en";
    var copy = map[lang];
    if (!copy) return;
    document.title = copy.title;
    var eyebrow = document.getElementById("nf-eyebrow");
    var heading = document.getElementById("nf-heading");
    var lead = document.getElementById("nf-lead");
    var homeBtn = document.getElementById("nf-home-btn");
    if (eyebrow) eyebrow.textContent = copy.eyebrow;
    if (heading) heading.textContent = copy.heading;
    if (lead) lead.textContent = copy.lead;
    if (homeBtn) {
      homeBtn.textContent = copy.homeBtn;
      homeBtn.setAttribute("href", copy.homeUrl);
    }
    if (searchBtn) searchBtn.textContent = copy.searchBtn;
  })();
</script>
