---
import "../../../styles/editorial-doc.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EntryRoutes from "../../../components/EntryRoutes.astro";
import ResponsivePhoto from "../../../components/ResponsivePhoto.astro";
import { FIRM } from "../../../data/firm";
import { getLocalizedPosts } from "../../../data/blog";
import { getPageContent } from "../../../data/pages-i18n";
import { getArticlesByAuthor } from "../../../data/wp";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const content = getPageContent(lang).marGamez;
const marMember = FIRM.team[0];
const marArticles = getArticlesByAuthor("Mar Gámez", 12);
const availableInLang = new Set(getLocalizedPosts(lang).map((p) => p.slug));
const articleHref = (slug: string) =>
  availableInLang.has(slug)
    ? localizedPath(lang, `legal-intelligence/${slug}`)
    : localizedPath("es", `legal-intelligence/${slug}`);

const personSchema = {
  "@type": "Person",
  "@id": `${FIRM.siteUrl}/es/equipo/mar-gamez/#person`,
  name: "Mar Gámez Ramírez",
  jobTitle: t.roleMarGamez,
  url: `${FIRM.siteUrl}${localizedPath(lang, "equipo/mar-gamez")}`,
  image: `${FIRM.siteUrl}${marMember.photo}`,
  sameAs: ["https://www.linkedin.com/in/marg%C3%A1mez/"],
  worksFor: { "@id": `${FIRM.siteUrl}/#organization` },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Universidad Loyola" },
    { "@type": "CollegeOrUniversity", name: "ISDE Law & Business School" },
    { "@type": "CollegeOrUniversity", name: "Universidad Carlos III de Madrid" },
  ],
  memberOf: [
    { "@type": "Organization", name: "Ilustre Colegio de la Abogacía de Madrid (ICAM n.º 137007)" },
    { "@type": "Organization", name: "Alpha Sigma Nu" },
    { "@type": "Organization", name: "ICEX-CECO" },
  ],
  award: "TOP 50 Premios Emprendemos — Junta de Andalucía",
  knowsLanguage: ["es", "en"],
};
---

<BaseLayout
  lang={lang}
  slug="equipo/mar-gamez"
  title={t.cvMetaTitle}
  description={t.cvMetaDesc}
  ogImage={marMember.photo}
  activeNav="firm"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.bcFirm, url: localizedPath(lang, "la-firma") },
    { name: "Mar Gámez Ramírez" },
  ]}
  jsonLdExtra={[personSchema]}
>
  <section class="doc-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <a href={localizedPath(lang, "la-firma")}>{t.bcFirm}</a>
        <span>/</span>
        <span>Mar Gámez Ramírez</span>
      </nav>

      <div class="cv-hero-grid">
        <div>
          <div class="doc-meta-row">
            <span class="doc-meta-pill">{t.cvEyebrow}</span>
            <span class="doc-meta-muted">{t.cvIcamLabel}</span>
          </div>
          <h1 class="doc-title">{t.cvTitle}</h1>
          <p class="doc-lead">{t.cvLead}</p>
          <div class="cv-badges">
            <span class="doc-meta-pill">Universidad Loyola</span>
            <span class="doc-meta-pill">LL.M. ISDE</span>
            <span class="doc-meta-pill">Alpha Sigma Nu</span>
            <span class="doc-meta-pill">Aranzadi Thomson Reuters</span>
          </div>
          <div class="doc-hero-actions">
            <a href={localizedPath(lang, "primera-reunion-juridica")} class="btn btn--lime btn--compact">
              {t.meetTitle} (350 €) →
            </a>
            <a
              href="https://www.linkedin.com/in/marg%C3%A1mez/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--outline-dark btn--compact"
            >
              {t.cvLinkedInBtn}
            </a>
          </div>
        </div>

        <div class="cv-portrait-frame">
          <ResponsivePhoto
            base={marMember.photoBase}
            widths={marMember.photoWidths}
            sizes="(max-width: 1024px) 240px, 320px"
            alt={`Mar Gámez Ramírez, ${t.roleMarGamez}`}
            width={marMember.width}
            height={marMember.height}
            eager={true}
          />
        </div>
      </div>

      <div class="meet-facts-bar">
        {content.highlights.map((h) => (
          <div class="meet-fact">
            <span class="meet-fact-label">{h.label}</span>
            <span class="meet-fact-value">{h.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div style="margin-bottom: 32px;" data-reveal>
        <p class="eyebrow eyebrow--on-cream">{content.areasTitle}</p>
        <div class="r5-cities-bar" style="margin-top: 12px;">
          <a href={localizedPath(lang, "private-clients")}><span>{t.navClients} →</span></a>
          <a href={localizedPath(lang, "private-wealth")}><span>{t.navWealth} →</span></a>
          <a href={localizedPath(lang, "business-disputes")}><span>{t.navDisputes} →</span></a>
          <a href={localizedPath(lang, "penal-economico-extradicion")}><span>{t.bcPenal} →</span></a>
        </div>
      </div>

      <div class="cv-sections-grid" data-reveal>
        {content.sections.map((sec, idx) => (
          <article class="cv-block">
            <h2>{sec.title}</h2>
            <p>{sec.p1}</p>
            <p>
              {sec.p2}
              {idx === content.sections.length - 1 && (
                <>
                  {" "}
                  <a href={localizedPath(lang, "medios")} style="text-decoration: underline;">
                    {t.mediosStripLink}
                  </a>
                </>
              )}
            </p>
          </article>
        ))}
      </div>

      {marArticles.length > 0 && (
        <div class="doc-related">
          <p class="eyebrow eyebrow--on-cream">{t.cvArticlesEyebrow}</p>
          <h2 class="section-title">{t.cvArticlesTitle}</h2>
          <div class="doc-related-grid">
            {marArticles.map((art) => (
              <article class="intel-card">
                <div>
                  <div class="intel-meta">
                    <span>{art.category}</span>
                    <span class="intel-date">{art.date}</span>
                  </div>
                  <h3 class="intel-title">{art.title}</h3>
                </div>
                <a href={articleHref(art.slug)} class="intel-link">
                  {t.blogReadFull}
                </a>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <EntryRoutes lang={lang} intro={t.entrySharedIntro} />
</BaseLayout>
