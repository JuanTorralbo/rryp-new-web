---
import "../../../styles/editorial-doc.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EntryRoutes from "../../../components/EntryRoutes.astro";
import ResponsivePhoto from "../../../components/ResponsivePhoto.astro";
import { FIRM } from "../../../data/firm";
import { getLocalizedPosts } from "../../../data/blog";
import { getPageContent } from "../../../data/pages-i18n";
import { getArticlesByAuthor } from "../../../data/wp";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const content = getPageContent(lang).marGamez;
const marMember = FIRM.team[0];
const marArticles = getArticlesByAuthor("Mar Gámez", 12);
const availableInLang = new Set(getLocalizedPosts(lang).map((p) => p.slug));
const articleHref = (slug: string) =>
  availableInLang.has(slug)
    ? localizedPath(lang, `legal-intelligence/${slug}`)
    : localizedPath("es", `legal-intelligence/${slug}`);

const thesisQuote = {
  es: "«Comprender cómo se relacionan derecho, empresa, estrategia y relaciones internacionales es lo que permite resolver asuntos complejos.»",
  en: "“Understanding how law, business, strategy and international relations intersect is what resolves genuinely complex matters.”",
  de: "„Zu verstehen, wie Recht, Unternehmen, Strategie und internationale Beziehungen ineinandergreifen, entscheidet komplexe Mandate.“",
  pt: "«Compreender como se ligam direito, empresa, estratégia e relações internacionais é o que permite resolver assuntos complexos.»",
  ru: "«Понимание взаимосвязи права, бизнеса, стратегии и международных отношений позволяет решать по-настоящему сложные дела.»",
  zh: "“洞察法律、商业、战略与国际关系的交汇点，正是破解复杂跨境案件的关键。”",
}[lang];

const practiceCards = [
  { num: "01", name: t.navClients, href: localizedPath(lang, "private-clients") },
  { num: "02", name: t.navWealth, href: localizedPath(lang, "private-wealth") },
  { num: "03", name: t.navDisputes, href: localizedPath(lang, "business-disputes") },
  { num: "04", name: t.bcPenal, href: localizedPath(lang, "penal-economico-extradicion") },
];

const educationRows = [
  {
    num: "01",
    org: "ISDE Law & Business School",
    role: "LL.M. International Business Law, Contracting & International Relations",
    note: content.sections[0].p2,
  },
  {
    num: "02",
    org: "ISDE — Universidad Carlos III de Madrid",
    role: {
      es: "Posgrado de Acceso a la Abogacía (Derecho de Empresa Internacional)",
      en: "Postgraduate Bar Admission Degree (International Corporate Law)",
      de: "Postgraduiertenstudium Anwaltszulassung (Internationales Wirtschaftsrecht)",
      pt: "Pós-graduação de Acesso à Advocacia (Direito Empresarial Internacional)",
      ru: "Последипломная программа допуска к адвокатуре (международное право)",
      zh: "律师执业研究生课程（国际商法方向）",
    }[lang],
    note: t.cvIcamLabel,
  },
  {
    num: "03",
    org: "Universidad Loyola — Alpha Sigma Nu",
    role: {
      es: "Doble Grado en Derecho y Relaciones Internacionales",
      en: "Dual Degree in Law and International Relations",
      de: "Doppelstudium Rechtswissenschaften & Internationale Beziehungen",
      pt: "Dupla Licenciatura em Direito e Relações Internacionais",
      ru: "Двойной диплом: Право и Международные отношения",
      zh: "法学与国际关系双学位（Alpha Sigma Nu 荣誉会员）",
    }[lang],
    note: content.sections[0].p1,
  },
];

const careerRows = [
  {
    num: "01",
    org: "RRYP Global — RELACIONATEYPUNTO, S.L.",
    role: t.roleMarGamez,
    note: content.sections[1].p1,
  },
  {
    num: "02",
    org: "Ilustre Colegio de la Abogacía de Madrid",
    role: t.cvIcamLabel,
    note: content.sections[1].p2,
  },
  {
    num: "03",
    org: "China — UE / Joint Ventures / Cámaras de Comercio",
    role: content.sections[3].title,
    note: content.sections[3].p1,
  },
];

const personSchema = {
  "@type": "Person",
  "@id": `${FIRM.siteUrl}/es/equipo/mar-gamez/#person`,
  name: "Mar Gámez Ramírez",
  jobTitle: t.roleMarGamez,
  url: `${FIRM.siteUrl}${localizedPath(lang, "equipo/mar-gamez")}`,
  image: `${FIRM.siteUrl}${marMember.photo}`,
  sameAs: ["https://www.linkedin.com/in/marg%C3%A1mez/"],
  worksFor: { "@id": `${FIRM.siteUrl}/#organization` },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Universidad Loyola" },
    { "@type": "CollegeOrUniversity", name: "ISDE Law & Business School" },
    { "@type": "CollegeOrUniversity", name: "Universidad Carlos III de Madrid" },
  ],
  memberOf: [
    { "@type": "Organization", name: "Ilustre Colegio de la Abogacía de Madrid (ICAM n.º 137007)" },
    { "@type": "Organization", name: "Alpha Sigma Nu" },
    { "@type": "Organization", name: "ICEX-CECO" },
  ],
  award: "TOP 50 Premios Emprendemos — Junta de Andalucía",
  knowsLanguage: ["es", "en"],
};
---

<BaseLayout
  lang={lang}
  slug="equipo/mar-gamez"
  title={t.cvMetaTitle}
  description={t.cvMetaDesc}
  ogImage={marMember.photo}
  activeNav="firm"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.bcFirm, url: localizedPath(lang, "la-firma") },
    { name: "Mar Gámez Ramírez" },
  ]}
  jsonLdExtra={[personSchema]}
>
  <section class="doc-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <a href={localizedPath(lang, "la-firma")}>{t.bcFirm}</a>
        <span>/</span>
        <span>Mar Gámez Ramírez</span>
      </nav>

      <div class="cv-hero-grid">
        <div>
          <div class="doc-meta-row">
            <span class="doc-meta-pill">{t.cvEyebrow}</span>
            <span class="doc-meta-muted">{t.cvIcamLabel}</span>
          </div>
          <h1 class="doc-title">{t.cvTitle}</h1>
          <p class="doc-lead">{t.cvLead}</p>
          <div class="cv-badges">
            <span class="doc-meta-pill">Universidad Loyola</span>
            <span class="doc-meta-pill">LL.M. ISDE</span>
            <span class="doc-meta-pill">Alpha Sigma Nu</span>
            <span class="doc-meta-pill">ICEX-CECO</span>
          </div>
          <div class="doc-hero-actions">
            <a href={localizedPath(lang, "primera-reunion-juridica")} class="btn btn--lime btn--compact">
              {t.meetTitle} (350 €) →
            </a>
            <a
              href="https://www.linkedin.com/in/marg%C3%A1mez/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--outline-dark btn--compact"
            >
              {t.cvLinkedInBtn}
            </a>
          </div>
        </div>

        <div class="cv-portrait-frame">
          <ResponsivePhoto
            base={marMember.photoBase}
            widths={marMember.photoWidths}
            sizes="(max-width: 1024px) 240px, 320px"
            alt={`Mar Gámez Ramírez, ${t.roleMarGamez}`}
            width={marMember.width}
            height={marMember.height}
            eager={true}
          />
        </div>
      </div>

      <div class="meet-facts-bar">
        {content.highlights.map((h) => (
          <div class="meet-fact">
            <span class="meet-fact-label">{h.label}</span>
            <span class="meet-fact-value">{h.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Banda burdeos de tesis ejecutiva -->
  <section class="cv-thesis-band">
    <div class="container cv-thesis-inner" data-reveal>
      <blockquote class="cv-thesis-quote">{thesisQuote}</blockquote>
      <div class="cv-thesis-meta">
        <span>{t.cvIcamLabel}</span>
        <p>Madrid / Málaga / Córdoba</p>
        <p>ES / EN</p>
      </div>
    </div>
  </section>

  <!-- Dossier asimetrico con jerarquia clara -->
  <section class="section-cream">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow eyebrow--on-cream">{content.areasTitle}</p>
        <div class="cv-practice-grid">
          {practiceCards.map((pc) => (
            <a href={pc.href} class="cv-practice-card">
              <span class="cv-practice-num">{pc.num}</span>
              <span class="cv-practice-name">{pc.name} →</span>
            </a>
          ))}
        </div>
      </div>

      <div class="cv-dossier-grid">
        <div class="cv-ledger">
          <div class="cv-ledger-group" data-reveal>
            <h2 class="cv-ledger-title">{content.sections[1].title}</h2>
            <div class="cv-ledger-list">
              {careerRows.map((row) => (
                <article class="cv-ledger-row">
                  <span class="cv-ledger-num">{row.num}</span>
                  <div>
                    <p class="cv-ledger-org">{row.org}</p>
                    <h3 class="cv-ledger-role">{row.role}</h3>
                    <p class="cv-ledger-note">{row.note}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="cv-ledger-group" data-reveal>
            <h2 class="cv-ledger-title">{content.sections[0].title}</h2>
            <div class="cv-ledger-list">
              {educationRows.map((row) => (
                <article class="cv-ledger-row">
                  <span class="cv-ledger-num">{row.num}</span>
                  <div>
                    <p class="cv-ledger-org">{row.org}</p>
                    <h3 class="cv-ledger-role">{row.role}</h3>
                    <p class="cv-ledger-note">{row.note}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>

        <aside class="cv-aside-stack">
          <div class="cv-dark-card" data-reveal>
            <p class="eyebrow" style="margin: 0;">{t.mediosAcadEyebrow}</p>
            <h2>{content.sections[2].title}</h2>
            <ul class="cv-dark-list">
              <li>
                <strong>Universidad Loyola</strong>
                Derecho Internacional Privado y Derecho Comparado
              </li>
              <li>
                <strong>ICEX-CECO / EOI / IMDEEC / IPRODECO</strong>
                {content.sections[2].p1}
              </li>
              <li>
                <strong>Aranzadi Thomson Reuters</strong>
                {content.sections[2].p2}
              </li>
            </ul>
            <a href={localizedPath(lang, "primera-reunion-juridica")} class="btn btn--lime btn--compact" style="width: 100%;">
              {t.meetTitle} (350 €) →
            </a>
          </div>

          <div class="cv-media-card" data-reveal>
            <p class="eyebrow eyebrow--on-cream" style="margin: 0;">{t.mediosEyebrow}</p>
            <div class="cv-media-logos">
              <img src="/assets/media-logos/lasexta-dark.webp" alt="laSexta Noticias" width="97" height="120" loading="lazy" />
              <img src="/assets/media-logos/deutschewelle-dark.webp" alt="Deutsche Welle" width="211" height="120" loading="lazy" />
              <img src="/assets/media-logos/larazon-dark.webp" alt="La Razón" width="125" height="120" loading="lazy" />
              <img src="/assets/media-logos/diariocordoba-dark.webp" alt="Diario Córdoba" width="129" height="120" loading="lazy" />
              <img src="/assets/media-logos/loyola-dark.webp" alt="Universidad Loyola" width="360" height="117" loading="lazy" />
            </div>
            <p class="cv-ledger-note" style="margin-bottom: 14px;">{content.sections[3].p2}</p>
            <a href={localizedPath(lang, "medios")} class="intel-link">
              {t.mediosStripLink}
            </a>
          </div>
        </aside>
      </div>

      {marArticles.length > 0 && (
        <div class="doc-related">
          <p class="eyebrow eyebrow--on-cream">{t.cvArticlesEyebrow}</p>
          <h2 class="section-title">{t.cvArticlesTitle}</h2>
          <div class="doc-related-grid">
            {marArticles.map((art) => (
              <article class="intel-card">
                <div>
                  <div class="intel-meta">
                    <span>{art.category}</span>
                    <span class="intel-date">{art.date}</span>
                  </div>
                  <h3 class="intel-title">{art.title}</h3>
                </div>
                <a href={articleHref(art.slug)} class="intel-link">
                  {t.blogReadFull}
                </a>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <EntryRoutes lang={lang} intro={t.entrySharedIntro} />
</BaseLayout>
