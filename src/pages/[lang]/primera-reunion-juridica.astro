---
import "../../styles/editorial-doc.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FIRM } from "../../data/firm";
import { getPageContent } from "../../data/pages-i18n";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const content = getPageContent(lang).primeraReunion;

const faqSchema = {
  "@type": "FAQPage",
  mainEntity: content.faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const serviceSchema = {
  "@type": "Service",
  name: t.meetTitle,
  description: t.meetMetaDesc,
  provider: { "@id": `${FIRM.siteUrl}/#organization` },
  offers: [
    {
      "@type": "Offer",
      name: t.e2Title,
      price: "350",
      priceCurrency: "EUR",
      url: FIRM.calendly.legal,
    },
    {
      "@type": "Offer",
      name: t.e3Title,
      price: "500",
      priceCurrency: "EUR",
      url: FIRM.calendly.urgent,
    },
  ],
};
---

<BaseLayout
  lang={lang}
  slug="primera-reunion-juridica"
  title={t.meetMetaTitle}
  description={t.meetMetaDesc}
  activeNav="firm"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.meetTitle },
  ]}
  jsonLdExtra={[serviceSchema, faqSchema]}
>
  <section class="doc-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.meetTitle}</span>
      </nav>

      <div class="doc-hero-inner">
        <div class="doc-meta-row">
          <span class="doc-meta-pill">{t.meetEyebrow}</span>
          <span class="doc-meta-muted">{t.meetFactFee}</span>
        </div>
        <h1 class="doc-title">{t.meetTitle}</h1>
        <p class="doc-lead">{t.meetLead}</p>
        <div class="doc-hero-actions">
          <a href="#reserva-rryp" class="btn btn--lime btn--compact">
            {t.meetCtaReserve}
          </a>
          <a href={localizedPath(lang, "casos")} class="btn btn--outline-dark btn--compact">
            {t.firmDirCta}
          </a>
        </div>
      </div>

      <div class="meet-facts-bar">
        <div class="meet-fact">
          <span class="meet-fact-label">{content.factLabels[0]}</span>
          <span class="meet-fact-value">{t.meetFactFee}</span>
        </div>
        <div class="meet-fact">
          <span class="meet-fact-label">{content.factLabels[1]}</span>
          <span class="meet-fact-value">{t.meetFactDur}</span>
        </div>
        <div class="meet-fact">
          <span class="meet-fact-label">{content.factLabels[2]}</span>
          <span class="meet-fact-value">{t.meetFactMod}</span>
        </div>
        <div class="meet-fact">
          <span class="meet-fact-label">{content.factLabels[3]}</span>
          <span class="meet-fact-value">{t.meetFactDir}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.meetAreasEyebrow}</p>
          <h2 class="section-title">{t.meetAreasTitle}</h2>
        </div>
        <p class="section-intro">{content.areasIntro}</p>
      </div>

      <div class="specialty-grid" data-reveal>
        {content.areas.map((area) => (
          <article class="intel-card">
            <div>
              <h3 class="intel-title">{area.title}</h3>
              <p class="intel-excerpt">{area.desc}</p>
            </div>
            <a href={localizedPath(lang, area.slug)} class="intel-link">
              {t.docReadSpecialty}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-cream section-cream--bordered">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.meetStratEyebrow}</p>
          <h2 class="section-title">{t.meetStratTitle}</h2>
        </div>
      </div>

      <div class="specialty-grid" data-reveal>
        {content.strategy.map((step) => (
          <article class="pillar-card">
            <div>
              <span class="pillar-index">{step.num}</span>
              <h3 class="pillar-name">{step.title}</h3>
              <p class="pillar-desc">{step.desc}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="section-header" style="margin-top: 56px;" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.meetIndepEyebrow}</p>
          <h2 class="section-title">{t.meetIndepTitle}</h2>
        </div>
        <p class="section-intro">
          {content.directionNote}{" "}
          <a href={localizedPath(lang, "equipo/mar-gamez")} style="text-decoration: underline;">
            Mar Gámez Ramírez ({t.cvIcamLabel})
          </a>.
        </p>
      </div>

      <div class="pillars-grid" data-reveal>
        {content.acceptance.map((item) => (
          <article class="pillar-card">
            <div>
              <span class="pillar-index">{item.num}</span>
              <h3 class="pillar-name">{item.title}</h3>
              <p class="pillar-desc">{item.desc}</p>
            </div>
          </article>
        ))}
      </div>

      <p class="meet-refund-note" data-reveal>
        {t.meetIndepRefund}
      </p>
    </div>
  </section>

  <section class="section-dark" id="reserva-rryp">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow">{t.meetBookEyebrow}</p>
          <h2 class="section-title">{t.meetBookTitle}</h2>
        </div>
        <p class="section-intro">{t.meetBookLead}</p>
      </div>

      <div class="meet-booking-box" data-reveal>
        <div class="meet-check-list">
          <label class="meet-check-item">
            <input type="checkbox" data-meet-check />
            <span>{t.meetCheck1}</span>
          </label>
          <label class="meet-check-item">
            <input type="checkbox" data-meet-check />
            <span>{t.meetCheck2}</span>
          </label>
          <label class="meet-check-item">
            <input type="checkbox" data-meet-check />
            <span>
              {t.meetCheck3Prefix}{" "}
              <a href={localizedPath(lang, "legal/condiciones")}>{t.legalTerms}</a>,{" "}
              <a href={localizedPath(lang, "legal/aviso-legal")}>{t.legalNotice}</a>{" "}
              / <a href={localizedPath(lang, "legal/privacidad")}>{t.legalPrivacy}</a>.
            </span>
          </label>
        </div>

        <p class="meet-book-hint" id="meet-book-hint">{t.meetBookHint}</p>

        <div class="meet-book-actions">
          <a
            href={FIRM.calendly.legal}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--lime"
            data-meet-action
            aria-disabled="true"
            tabindex="-1"
          >
            {t.meetBookStd}
          </a>
          <a
            href={FIRM.calendly.urgent}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline-dark"
            data-meet-action
            aria-disabled="true"
            tabindex="-1"
          >
            {t.meetBookUrg}
          </a>
          <a
            href={FIRM.calendly.initial}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline-dark"
          >
            {t.e1Title} ({t.e1Fee}) →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.meetFaqEyebrow}</p>
          <h2 class="section-title">{t.meetFaqTitle}</h2>
        </div>
      </div>

      <div class="meet-faq-list" data-reveal>
        {content.faqs.map((item, idx) => (
          <details class="meet-faq-item" open={idx === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    const checks = Array.from(document.querySelectorAll<HTMLInputElement>("[data-meet-check]"));
    const actions = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-meet-action]"));
    const hint = document.getElementById("meet-book-hint");

    const syncBookingGate = () => {
      const ready = checks.length > 0 && checks.every((c) => c.checked);
      actions.forEach((a) => {
        a.setAttribute("aria-disabled", ready ? "false" : "true");
        if (ready) {
          a.removeAttribute("tabindex");
        } else {
          a.setAttribute("tabindex", "-1");
        }
      });
      if (hint) {
        hint.hidden = ready;
      }
    };

    checks.forEach((c) => c.addEventListener("change", syncBookingGate));
    syncBookingGate();
  </script>
</BaseLayout>
