---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import ResponsivePhoto from "../../components/ResponsivePhoto.astro";
import { FIRM } from "../../data/firm";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);

const aboutSchema = {
  "@type": "AboutPage",
  name: t.metaFirmTitle,
  description: t.metaFirmDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "la-firma")}`,
  isPartOf: { "@id": `${FIRM.siteUrl}/#website` },
  about: { "@id": `${FIRM.siteUrl}/#organization` },
};
---

<BaseLayout
  lang={lang}
  slug="la-firma"
  title={t.metaFirmTitle}
  description={t.metaFirmDesc}
  ogImage={FIRM.photos.editorial}
  activeNav="firm"
  breadcrumbLabel={t.bcFirm}
  jsonLdExtra={[aboutSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.bcFirm}</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.firmEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.firmHeroTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.firmHeroLead}</p>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d3">
          <p class="subhero-aside-label">{t.firmAsideLabel}</p>
          <p>{t.firmAsideText}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.firmHowEyebrow}</p>
          <h2 class="section-title">{t.firmHowTitle}</h2>
        </div>
        <p class="section-intro">{t.firmHowIntro}</p>
      </div>

      <div class="pillars-grid" data-reveal>
        <article class="pillar-card">
          <div>
            <span class="pillar-index">01</span>
            <h3 class="pillar-name">{t.firmP1Title}</h3>
            <p class="pillar-desc">{t.firmP1Desc}</p>
          </div>
        </article>
        <article class="pillar-card">
          <div>
            <span class="pillar-index">02</span>
            <h3 class="pillar-name">{t.firmP2Title}</h3>
            <p class="pillar-desc">{t.firmP2Desc}</p>
          </div>
        </article>
        <article class="pillar-card">
          <div>
            <span class="pillar-index">03</span>
            <h3 class="pillar-name">{t.firmP3Title}</h3>
            <p class="pillar-desc">{t.firmP3Desc}</p>
          </div>
        </article>
      </div>

      <div class="editorial-split" data-reveal>
        <div class="photo-slot photo-slot--4x3 photo-slot--on-cream has-photo">
          <ResponsivePhoto
            base={FIRM.photos.editorialBase}
            widths={FIRM.photos.editorialWidths}
            sizes="(max-width: 1160px) 92vw, 48vw"
            alt={t.altFounders}
            width={1600}
            height={1200}
          />
        </div>
        <div class="editorial-copy">
          <p class="eyebrow eyebrow--on-cream">{t.firmDirEyebrow}</p>
          <h3>{t.firmDirTitle}</h3>
          <p>{t.firmDirP1}</p>
          <p>{t.firmDirP2}</p>
          <a href={localizedPath(lang, "casos")} class="btn btn--dark">{t.firmDirCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream section-cream--bordered">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.firmTeamEyebrow}</p>
          <h2 class="section-title">{t.firmTeamTitle}</h2>
        </div>
        <p class="section-intro">{t.firmTeamIntro}</p>
      </div>

      <div class="team-grid">
        {FIRM.team.map((member) => (
          <article class="team-card" data-reveal>
            <div class="photo-slot photo-slot--4x5 photo-slot--on-cream has-photo">
              <ResponsivePhoto
                base={member.photoBase}
                widths={member.photoWidths}
                sizes="(max-width: 680px) 88vw, (max-width: 1160px) 32vw, 240px"
                alt={`${member.name}, ${t[member.roleKey]}`}
                width={member.width}
                height={member.height}
              />
            </div>
            <div class="team-meta">
              <h3 class="team-name">{member.name}</h3>
              <p class="team-role">{t[member.roleKey]}</p>
              <p class="team-bio">{t[member.bioKey]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <EntryRoutes lang={lang} heading={t.firmEntryTitle} intro={t.entrySharedIntro} />
</BaseLayout>
