---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import { FIRM } from "../../data/firm";
import { getLocalizedPosts } from "../../data/blog";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const posts = getLocalizedPosts(lang, "business-disputes").slice(0, 6);
const totalCount = getLocalizedPosts(lang, "business-disputes").length;

const serviceSchema = {
  "@type": "Service",
  name: "Business Disputes",
  serviceType: "Business Disputes",
  description: t.metaBdDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "business-disputes")}`,
  provider: { "@id": `${FIRM.siteUrl}/#organization` },
  areaServed: ["España", "Unión Europea", "Madrid", "Málaga", "Córdoba"],
};

const listSchema = {
  "@type": "ItemList",
  name: t.bdBlogTitle,
  numberOfItems: posts.length,
  itemListElement: posts.map((p, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    name: p.title,
    url: p.url,
  })),
};
---

<BaseLayout
  lang={lang}
  slug="business-disputes"
  title={t.metaBdTitle}
  description={t.metaBdDesc}
  ogImage="/assets/photos/hero-malaga-reuniones-1024w.webp"
  activeNav="disputes"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.bcPillar03, url: `${localizedPath(lang)}#areas` },
    { name: "Business Disputes" },
  ]}
  jsonLdExtra={[serviceSchema, listSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.bcPillar03}</span>
        <span>/</span>
        <span>Business Disputes</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.bdHeroEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.bdHeroTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.bdHeroLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime">
              {t.pCta350}
            </a>
            <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=business-disputes`} class="btn btn--outline-dark">
              {t.bdAllBtn}
            </a>
          </div>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d4">
          <p class="subhero-aside-label">{t.bdAsideLabel}</p>
          <p>{t.bdAsideText}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.pScopeEyebrow}</p>
          <h2 class="section-title">{t.bdScopeTitle}</h2>
        </div>
        <p class="section-intro">{t.bdScopeIntro}</p>
      </div>

      <div class="scope-grid" data-reveal>
        <article class="scope-item">
          <h3>{t.bdS1T}</h3>
          <p>{t.bdS1P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.bdS2T}</h3>
          <p>{t.bdS2P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.bdS3T}</h3>
          <p>{t.bdS3P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.bdS4T}</h3>
          <p>{t.bdS4P}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-burgundy">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow">{t.pCasesEyebrow}</p>
          <h2 class="section-title">{t.bdCasesTitle}</h2>
        </div>
        <p class="section-intro">{t.pillarCasesIntroBd}</p>
      </div>

      <div class="cases-list" data-reveal>
        <div class="case-row">
          <span class="case-pillar-tag">{t.bdCase1Tag}</span>
          <p class="case-row-title">{t.bdCase1Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.bdCase2Tag}</span>
          <p class="case-row-title">{t.bdCase2Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.bdCase3Tag}</span>
          <p class="case-row-title">{t.bdCase3Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.bdCase4Tag}</span>
          <p class="case-row-title">{t.bdCase4Title}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">RRYP Legal Intelligence</p>
          <h2 class="section-title">{t.bdBlogTitle}</h2>
        </div>
        <p class="section-intro">
          {t.blogPillarCount.replace("{count}", String(totalCount))}
        </p>
      </div>

      <div class="blog-archive-grid">
        {posts.map((post) => (
          <article class="intel-card">
            <div>
              <div class="intel-meta">
                <span>Business Disputes</span>
                <span class="intel-date">{post.date}</span>
              </div>
              <h3 class="intel-title">{post.title}</h3>
              <p class="intel-excerpt">{post.excerpt}</p>
            </div>
            <a href={post.url} target="_blank" rel="noopener noreferrer" class="intel-link">
              {t.blogReadFull}
            </a>
          </article>
        ))}
      </div>

      <div class="blog-pagination">
        <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=business-disputes`} class="btn btn--dark">
          {t.pillarBlogReadAll}
        </a>
      </div>
    </div>
  </section>

  <EntryRoutes lang={lang} heading={t.bdEntryTitle} intro={t.entrySharedIntro} />
</BaseLayout>
