---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import ResponsivePhoto from "../../components/ResponsivePhoto.astro";
import { FIRM } from "../../data/firm";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const office = FIRM.offices[1];

const localSchema = {
  "@type": "LegalService",
  name: "RRYP Global Málaga",
  url: `${FIRM.siteUrl}${localizedPath(lang, "malaga")}`,
  image: `${FIRM.siteUrl}${office.photo.split("?")[0]}`,
  telephone: FIRM.phone,
  email: FIRM.email,
  priceRange: "350 € - 500 €",
  knowsLanguage: [...LOCALES],
  hasMap: office.mapsUrl,
  parentOrganization: { "@id": `${FIRM.siteUrl}/#organization` },
  address: {
    "@type": "PostalAddress",
    streetAddress: office.street,
    postalCode: office.postalCode,
    addressLocality: office.city,
    addressCountry: "ES",
  },
  geo: { "@type": "GeoCoordinates", latitude: office.lat, longitude: office.lng },
  areaServed: ["Málaga", "Marbella", "Costa del Sol", "Andalucía"],
  openingHoursSpecification: [
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "09:00", closes: "14:00" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"], opens: "16:00", closes: "19:15" },
    { "@type": "OpeningHoursSpecification", dayOfWeek: ["Friday"], opens: "08:00", closes: "15:00" },
  ],
};
---

<BaseLayout
  lang={lang}
  slug="malaga"
  title={t.metaMalagaTitle}
  description={t.metaMalagaDesc}
  ogImage={office.photo}
  preloadBase={office.photoBase}
  preloadWidths={office.photoWidths}
  preloadSizes="(max-width: 1160px) 92vw, 48vw"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.bcOffices, url: `${localizedPath(lang)}#sedes` },
    { name: "Málaga" },
  ]}
  jsonLdExtra={[localSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <a href={`${localizedPath(lang)}#sedes`}>{t.bcOffices}</a>
        <span>/</span>
        <span>Málaga</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.officeEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.officeMalagaTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.malagaLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime">{t.pCta350}</a>
            <a href={FIRM.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark">WhatsApp {FIRM.phone}</a>
          </div>
        </div>
        <div class="photo-slot photo-slot--16x9 has-photo hero-anim hero-anim--d4">
          <ResponsivePhoto
            base={office.photoBase}
            widths={office.photoWidths}
            sizes="(max-width: 1160px) 92vw, 48vw"
            alt={t.altMalagaOffice}
            width={office.photoWidth}
            height={office.photoHeight}
            eager={true}
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="offices-layout">
        <div class="offices-list">
          <div class="office-row">
            <h2 class="office-city">{t.officeAddressLabel}</h2>
            <div>
              <p class="office-address">{office.fullAddress}</p>
              <p class="office-note">{t.malagaServiceNote}</p>
              <a href={office.mapsUrl} target="_blank" rel="noopener noreferrer" class="office-maps-link">
                {t.officeMapsLink}
              </a>
            </div>
          </div>
          <div class="office-row">
            <h2 class="office-city">{t.officeHoursLabel}</h2>
            <div>
              <p class="office-address">{t.officeHoursDetail}</p>
              <p
                class="office-live-status office-live-status--on-cream"
                data-office-status
                data-open={t.statusOpenNow}
                data-closed={t.statusClosedNow}
                aria-live="polite"
              ></p>
            </div>
          </div>
          <div class="office-row">
            <h2 class="office-city">{t.officePracticeLabel}</h2>
            <p class="office-address">{t.malagaPractice}</p>
          </div>
        </div>
        <aside class="contact-panel">
          <div class="contact-block">
            <p class="contact-label">{t.contactPhoneLabel}</p>
            <a href={FIRM.phoneHref} class="contact-value">{FIRM.phone}</a>
          </div>
          <div class="contact-block">
            <p class="contact-label">{t.contactEmailLabel}</p>
            <a href={FIRM.emailHref} class="contact-value">{FIRM.email}</a>
          </div>
          <div class="contact-block">
            <p class="contact-label">{t.officeOthersLabel}</p>
            <p class="contact-sub">
              <a href={localizedPath(lang, "madrid")}>Madrid →</a><br />
              <a href={localizedPath(lang, "cordoba")}>Córdoba →</a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <EntryRoutes lang={lang} heading={t.officeEntryTitle} intro={t.entrySharedIntro} />
</BaseLayout>
