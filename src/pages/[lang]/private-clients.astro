---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import { FIRM } from "../../data/firm";
import { getLocalizedPosts } from "../../data/blog";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const posts = getLocalizedPosts(lang, "private-clients").slice(0, 6);
const totalCount = getLocalizedPosts(lang, "private-clients").length;

const serviceSchema = {
  "@type": "Service",
  name: "Private Clients",
  serviceType: "Private Clients",
  description: t.metaPcDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "private-clients")}`,
  provider: { "@id": `${FIRM.siteUrl}/#organization` },
};
---

<BaseLayout
  lang={lang}
  slug="private-clients"
  title={t.metaPcTitle}
  description={t.metaPcDesc}
  ogImage="/assets/photos/hero-socias.webp"
  activeNav="clients"
  breadcrumbLabel="Private Clients"
  jsonLdExtra={[serviceSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.bcPillar01}</span>
        <span>/</span>
        <span>Private Clients</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.pcHeroEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.pcHeroTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.pcHeroLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime">
              {t.pCta350}
            </a>
            <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=private-clients`} class="btn btn--outline-dark">
              {t.pcAllBtn}
            </a>
          </div>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d4">
          <p class="subhero-aside-label">{t.pcAsideLabel}</p>
          <p>{t.pcAsideText}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.pScopeEyebrow}</p>
          <h2 class="section-title">{t.pcScopeTitle}</h2>
        </div>
        <p class="section-intro">{t.pcScopeIntro}</p>
      </div>

      <div class="scope-grid" data-reveal>
        <article class="scope-item">
          <h3>{t.pcS1T}</h3>
          <p>{t.pcS1P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pcS2T}</h3>
          <p>{t.pcS2P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pcS3T}</h3>
          <p>{t.pcS3P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pcS4T}</h3>
          <p>{t.pcS4P}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-burgundy">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow">{t.pCasesEyebrow}</p>
          <h2 class="section-title">{t.pcCasesTitle}</h2>
        </div>
        <p class="section-intro">{t.pillarCasesIntroPc}</p>
      </div>

      <div class="cases-list" data-reveal>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pcCase1Tag}</span>
          <p class="case-row-title">{t.pcCase1Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pcCase2Tag}</span>
          <p class="case-row-title">{t.pcCase2Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pcCase3Tag}</span>
          <p class="case-row-title">{t.pcCase3Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pcCase4Tag}</span>
          <p class="case-row-title">{t.pcCase4Title}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">RRYP Legal Intelligence</p>
          <h2 class="section-title">{t.pcBlogTitle}</h2>
        </div>
        <p class="section-intro">
          {t.blogPillarCount.replace("{count}", String(totalCount))}
        </p>
      </div>

      <div class="blog-archive-grid">
        {posts.map((post) => (
          <article class="intel-card">
            <div>
              <div class="intel-meta">
                <span>Private Clients</span>
                <span class="intel-date">{post.date}</span>
              </div>
              <h3 class="intel-title">{post.title}</h3>
              <p class="intel-excerpt">{post.excerpt}</p>
            </div>
            <a href={post.url} target="_blank" rel="noopener noreferrer" class="intel-link">
              {t.blogReadFull}
            </a>
          </article>
        ))}
      </div>

      <div class="blog-pagination">
        <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=private-clients`} class="btn btn--dark">
          {t.pillarBlogReadAll}
        </a>
      </div>
    </div>
  </section>

  <EntryRoutes lang={lang} heading={t.pcEntryTitle} intro={t.entrySharedIntro} />
</BaseLayout>
