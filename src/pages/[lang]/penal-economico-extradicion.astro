---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { FIRM } from "../../data/firm";
import { getSpecialtiesByPillar } from "../../data/wp";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const specialties = getSpecialtiesByPillar("penal");

const serviceSchema = {
  "@type": "Service",
  name: t.metaPenalTitle,
  serviceType: t.penalEyebrow,
  description: t.metaPenalDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "penal-economico-extradicion")}`,
  provider: { "@id": `${FIRM.siteUrl}/#organization` },
};
---

<BaseLayout
  lang={lang}
  slug="penal-economico-extradicion"
  title={t.metaPenalTitle}
  description={t.metaPenalDesc}
  urgentHeaderCta={true}
  breadcrumbLabel={t.penalEyebrow}
  jsonLdExtra={[serviceSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.bcPenal}</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.penalEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.penalHeroTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.penalHeroLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={FIRM.calendly.urgent} target="_blank" rel="noopener noreferrer" class="btn btn--lime">
              {t.penalUrgentCta}
            </a>
            <a href={FIRM.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark">
              WhatsApp {FIRM.phone}
            </a>
          </div>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d4">
          <p class="subhero-aside-label">{t.penalDecisionLabel}</p>
          <p>{t.penalDecisionText}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-burgundy">
    <div class="container">
      <div class="cases-list">
        <div class="case-row">
          <span class="case-pillar-tag">{t.penalCase1Tag}</span>
          <p class="case-row-title">{t.penalCase1Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.penalCase2Tag}</span>
          <p class="case-row-title">{t.penalCase2Title}</p>
        </div>
      </div>
    </div>
  </section>

  {specialties.length > 0 && (
    <section class="section-cream">
      <div class="container">
        <p class="eyebrow eyebrow--on-cream">{t.docSpecialtiesEyebrow}</p>
        <h2 class="section-title">{t.docSpecialtiesTitle}</h2>
        <div class="specialty-grid" style="margin-top: 28px;">
          {specialties.map((sp) => (
            <article class="intel-card">
              <div>
                <div class="intel-meta">
                  <span>{sp.pillarLabel}</span>
                  <span class="intel-date">{sp.readingMin} {t.docReadingMin}</span>
                </div>
                <h3 class="intel-title">{sp.title}</h3>
                <p class="intel-excerpt">{sp.lead}</p>
              </div>
              <a href={localizedPath(lang, `especialidades/${sp.slug}`)} class="intel-link">
                {t.docExploreSpecialty}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
