---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import { FIRM } from "../../data/firm";
import { getLocalizedPosts } from "../../data/blog";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const posts = getLocalizedPosts(lang, "private-wealth").slice(0, 6);
const totalCount = getLocalizedPosts(lang, "private-wealth").length;

const serviceSchema = {
  "@type": "Service",
  name: "Private Wealth",
  serviceType: "Private Wealth",
  description: t.metaPwDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "private-wealth")}`,
  provider: { "@id": `${FIRM.siteUrl}/#organization` },
};
---

<BaseLayout
  lang={lang}
  slug="private-wealth"
  title={t.metaPwTitle}
  description={t.metaPwDesc}
  ogImage="/assets/photos/editorial-madrid.webp"
  activeNav="wealth"
  breadcrumbLabel="Private Wealth"
  jsonLdExtra={[serviceSchema]}
>
  <section class="subhero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <span>{t.bcPillar02}</span>
        <span>/</span>
        <span>Private Wealth</span>
      </nav>

      <div class="subhero-grid">
        <div>
          <p class="eyebrow hero-anim">{t.pwHeroEyebrow}</p>
          <h1 class="hero-title hero-anim hero-anim--d1" set:html={t.pwHeroTitle} />
          <p class="hero-lead hero-anim hero-anim--d2">{t.pwHeroLead}</p>
          <div class="hero-cta-group hero-anim hero-anim--d3">
            <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime">
              {t.pCta350}
            </a>
            <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=private-wealth`} class="btn btn--outline-dark">
              {t.pwAllBtn}
            </a>
          </div>
        </div>

        <aside class="subhero-aside hero-anim hero-anim--d4">
          <p class="subhero-aside-label">{t.pwAsideLabel}</p>
          <p>{t.pwAsideText}</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.pScopeEyebrow}</p>
          <h2 class="section-title">{t.pwScopeTitle}</h2>
        </div>
        <p class="section-intro">{t.pwScopeIntro}</p>
      </div>

      <div class="scope-grid" data-reveal>
        <article class="scope-item">
          <h3>{t.pwS1T}</h3>
          <p>{t.pwS1P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pwS2T}</h3>
          <p>{t.pwS2P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pwS3T}</h3>
          <p>{t.pwS3P}</p>
        </article>
        <article class="scope-item">
          <h3>{t.pwS4T}</h3>
          <p>{t.pwS4P}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-burgundy">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow">{t.pCasesEyebrow}</p>
          <h2 class="section-title">{t.pwCasesTitle}</h2>
        </div>
        <p class="section-intro">{t.pillarCasesIntroPw}</p>
      </div>

      <div class="cases-list" data-reveal>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pwCase1Tag}</span>
          <p class="case-row-title">{t.pwCase1Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pwCase2Tag}</span>
          <p class="case-row-title">{t.pwCase2Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pwCase3Tag}</span>
          <p class="case-row-title">{t.pwCase3Title}</p>
        </div>
        <div class="case-row">
          <span class="case-pillar-tag">{t.pwCase4Tag}</span>
          <p class="case-row-title">{t.pwCase4Title}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">RRYP Legal Intelligence</p>
          <h2 class="section-title">{t.pwBlogTitle}</h2>
        </div>
        <p class="section-intro">
          {t.blogPillarCount.replace("{count}", String(totalCount))}
        </p>
      </div>

      <div class="blog-archive-grid">
        {posts.map((post) => (
          <article class="intel-card">
            <div>
              <div class="intel-meta">
                <span>Private Wealth</span>
                <span class="intel-date">{post.date}</span>
              </div>
              <h3 class="intel-title">{post.title}</h3>
              <p class="intel-excerpt">{post.excerpt}</p>
            </div>
            <a href={post.url} target="_blank" rel="noopener noreferrer" class="intel-link">
              {t.blogReadFull}
            </a>
          </article>
        ))}
      </div>

      <div class="blog-pagination">
        <a href={`${localizedPath(lang, "legal-intelligence")}?pilar=private-wealth`} class="btn btn--dark">
          {t.pillarBlogReadAll}
        </a>
      </div>
    </div>
  </section>

  <EntryRoutes lang={lang} heading={t.pwEntryTitle} intro={t.entrySharedIntro} />
</BaseLayout>
