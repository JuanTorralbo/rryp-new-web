---
import "../../styles/editorial-doc.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaStrip from "../../components/MediaStrip.astro";
import EntryRoutes from "../../components/EntryRoutes.astro";
import { FIRM } from "../../data/firm";
import { getPageContent } from "../../data/pages-i18n";
import { getDictionary, LOCALES, localizedPath, type Locale } from "../../i18n";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getDictionary(lang);
const content = getPageContent(lang).historia;

const HIST_LOGO_DIMS: Record<string, [number, number]> = {
  "lawandtrends-dark.webp": [194, 120],
  "deutschewelle-dark.webp": [211, 120],
  "eudebusinessschool-dark.webp": [360, 71],
  "lasexta-dark.webp": [97, 120],
  "larazon-dark.webp": [125, 120],
  "loyola-dark.webp": [360, 117],
};

interface TimelineLink {
  label: string;
  href: string;
  external?: boolean;
}

function resolveLinks(linkType: string): TimelineLink[] {
  switch (linkType) {
    case "cv":
      return [{ label: t.cvProfileBtn, href: localizedPath(lang, "equipo/mar-gamez") }];
    case "firm":
      return [{ label: `${t.bcFirm} →`, href: localizedPath(lang, "la-firma") }];
    case "cordoba_press":
      return [
        { label: content.officeCordoba, href: localizedPath(lang, "cordoba") },
        { label: t.mediosReadBtn, href: "https://www.lawandtrends.com/noticias/rryp-global/rryp-global-inaugura-su-primera-oficina-en-cordoba-1.html", external: true },
      ];
    case "top50":
      return [{ label: t.histReadSource, href: localizedPath("es", "legal-intelligence/rryp-es-galardonada-como-empresa-top50") }];
    case "medios_2023":
      return [
        { label: t.mediosStripLink, href: localizedPath(lang, "medios") },
        { label: t.histReadSource, href: localizedPath("es", "legal-intelligence/mar-gamez-es-entrevistada-en-lasexta") },
      ];
    case "madrid_malaga":
      return [
        { label: content.officeMadrid, href: localizedPath(lang, "madrid") },
        { label: content.officeMalaga, href: localizedPath(lang, "malaga") },
      ];
    case "medios":
      return [{ label: t.mediosStripLink, href: localizedPath(lang, "medios") }];
    case "larazon":
      return [
        { label: t.histReadSource, href: localizedPath("es", "legal-intelligence/pienso-luego-exito") },
        { label: t.mediosReadBtn, href: "https://www.larazon.es/economia/justicia-admite-tramite-querella-presunta-estafa-alvaro-pintado_2025072868871fffabb2960d1fb7a262.html", external: true },
      ];
    case "loyola":
      return [
        { label: t.histReadSource, href: localizedPath("es", "legal-intelligence/entrevista-a-mar-gamez-diario-cordoba") },
        { label: t.histReadSource, href: localizedPath("es", "legal-intelligence/mar-gamez-docente-en-universidad-loyola") },
      ];
    case "present":
      return [
        { label: t.r5CtaLabel, href: localizedPath(lang, "rryp-en-5") },
        { label: "RRYP Legal Intelligence →", href: localizedPath(lang, "legal-intelligence") },
      ];
    default:
      return [];
  }
}

const historySchema = {
  "@type": "AboutPage",
  name: t.histMetaTitle,
  description: t.histMetaDesc,
  url: `${FIRM.siteUrl}${localizedPath(lang, "historia")}`,
  about: {
    "@id": `${FIRM.siteUrl}/#organization`,
    foundingDate: "2021-01",
    foundingLocation: {
      "@type": "Place",
      name: "Córdoba, España",
    },
  },
};
---

<BaseLayout
  lang={lang}
  slug="historia"
  title={t.histMetaTitle}
  description={t.histMetaDesc}
  activeNav="firm"
  breadcrumbs={[
    { name: t.bcHome, url: localizedPath(lang) },
    { name: t.bcFirm, url: localizedPath(lang, "la-firma") },
    { name: t.histTitle },
  ]}
  jsonLdExtra={[historySchema]}
>
  <section class="doc-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label={t.ariaBreadcrumb}>
        <a href={localizedPath(lang)}>{t.bcHome}</a>
        <span>/</span>
        <a href={localizedPath(lang, "la-firma")}>{t.bcFirm}</a>
        <span>/</span>
        <span>{t.histTitle}</span>
      </nav>

      <div class="doc-hero-inner">
        <div class="doc-meta-row">
          <span class="doc-meta-pill">{t.histEyebrow}</span>
          <span class="doc-meta-muted">RELACIONATEYPUNTO, S.L. (NIF B42713768)</span>
        </div>
        <h1 class="doc-title">{t.histTitle}</h1>
        <p class="doc-lead">{t.histLead}</p>
        <div class="doc-hero-actions">
          <a href={localizedPath(lang, "la-firma")} class="btn btn--lime btn--compact">
            {t.bcFirm} →
          </a>
          <a href={localizedPath(lang, "medios")} class="btn btn--outline-dark btn--compact">
            {t.mediosTitle} →
          </a>
          <a href={localizedPath(lang, "rryp-en-5")} class="btn btn--outline-dark btn--compact">
            {t.r5CtaLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-cream">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.histStagesEyebrow}</p>
          <h2 class="section-title">{t.histStagesTitle}</h2>
        </div>
      </div>

      <div class="pillars-grid" data-reveal>
        {content.stages.map((st) => (
          <article class="pillar-card">
            <div>
              <span class="pillar-index">{st.num} — {st.period}</span>
              <h3 class="pillar-name">{st.name}</h3>
              <p class="pillar-desc">{st.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-cream section-cream--bordered">
    <div class="container">
      <div class="section-header" data-reveal>
        <div>
          <p class="eyebrow eyebrow--on-cream">{t.histTimelineEyebrow}</p>
          <h2 class="section-title">{t.histTimelineTitle}</h2>
        </div>
        <p class="section-intro">{t.histTimelineLead}</p>
      </div>

      <div class="hist-timeline">
        {content.timeline.map((ev) => {
          const links = resolveLinks(ev.linkType);
          return (
            <article class="hist-entry" data-reveal>
              <div class="hist-date-col">
                <span class="hist-year">{ev.year}</span>
                <span class="hist-month">{ev.month}</span>
              </div>
              <div class="hist-card">
                <div class="hist-card-top">
                  <span class="hist-card-tag">{ev.tag}</span>
                  {"logo" in ev && ev.logo && (
                    <img
                      src={`/assets/media-logos/${ev.logo}`}
                      alt={ev.logoAlt || ev.tag}
                      width={HIST_LOGO_DIMS[ev.logo]?.[0] ?? 180}
                      height={HIST_LOGO_DIMS[ev.logo]?.[1] ?? 120}
                      loading="lazy"
                      decoding="async"
                      class="hist-card-logo"
                    />
                  )}
                </div>
                <h3 class="hist-card-title">{ev.title}</h3>
                <p class="hist-card-desc">{ev.desc}</p>
                {links.length > 0 && (
                  <div class="hist-card-links">
                    {links.map((lnk) => (
                      <a
                        href={lnk.href}
                        target={lnk.external ? "_blank" : undefined}
                        rel={lnk.external ? "noopener noreferrer" : undefined}
                        class="intel-link"
                      >
                        {lnk.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section-burgundy">
    <div class="container">
      <div class="authority-grid" data-reveal>
        {content.metrics.map((m) => (
          <div class="authority-item">
            <span class="authority-figure">{m.num}</span>
            <h3 class="authority-heading">{m.head}</h3>
            <p class="authority-text">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <MediaStrip lang={lang} />

  <EntryRoutes lang={lang} intro={t.entrySharedIntro} />
</BaseLayout>
