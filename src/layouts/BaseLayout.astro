---
import "../styles/global.css";
import { FIRM } from "../data/firm";
import CookieConsent from "../components/CookieConsent.astro";
import SiteWidgets from "../components/SiteWidgets.astro";
import {
  DEFAULT_LOCALE,
  getDictionary,
  LOCALE_LABELS,
  LOCALES,
  localizedPath,
  type Locale,
} from "../i18n";

export interface Props {
  lang: Locale;
  slug?: string;
  title: string;
  description: string;
  ogImage?: string;
  preloadImage?: string;
  preloadBase?: string;
  preloadWidths?: readonly number[];
  preloadSizes?: string;
  activeNav?: "clients" | "wealth" | "disputes" | "cases" | "firm" | "intel" | "home";
  urgentHeaderCta?: boolean;
  fullFooter?: boolean;
  noindex?: boolean;
  availableLocales?: readonly Locale[];
  langFallbackSlug?: string;
  breadcrumbLabel?: string;
  breadcrumbs?: { name: string; url?: string }[];
  jsonLdExtra?: Record<string, unknown>[];
}

const {
  lang,
  slug = "",
  title,
  description,
  ogImage = "/assets/og-rryp-global.png",
  preloadImage,
  preloadBase,
  preloadWidths,
  preloadSizes = "(max-width: 1160px) 92vw, 52vw",
  activeNav = "home",
  urgentHeaderCta = false,
  fullFooter = false,
  noindex = false,
  availableLocales,
  langFallbackSlug = "",
  breadcrumbLabel,
  breadcrumbs,
  jsonLdExtra = [],
} = Astro.props;

const preloadAvifSrcset =
  preloadBase && preloadWidths
    ? preloadWidths.map((w) => `/assets/photos/${preloadBase}-${w}w.avif?v4 ${w}w`).join(", ")
    : undefined;

const t = getDictionary(lang);
const cleanSlug = slug.replace(/^\/+|\/+$/g, "");
const validLocales = availableLocales && availableLocales.length > 0 ? availableLocales : LOCALES;
const langSwitchHref = (loc: Locale) =>
  localizedPath(loc, validLocales.includes(loc) ? cleanSlug : langFallbackSlug);
const currentPath = localizedPath(lang, cleanSlug);
const canonicalUrl = `${FIRM.siteUrl}${currentPath}`;
const xDefaultLocale = validLocales.includes(DEFAULT_LOCALE) ? DEFAULT_LOCALE : validLocales[0];
const xDefaultUrl = `${FIRM.siteUrl}${localizedPath(xDefaultLocale, cleanSlug)}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${FIRM.siteUrl}${ogImage}`;

const orgNode = {
  "@type": "LegalService",
  "@id": `${FIRM.siteUrl}/#organization`,
  name: FIRM.brand,
  legalName: FIRM.legalName,
  alternateName: "RRYP Global International Legal Boutique",
  url: `${FIRM.siteUrl}/`,
  logo: `${FIRM.siteUrl}/assets/logos/rryp-logo-gold.webp`,
  image: `${FIRM.siteUrl}/assets/photos/editorial-cordoba.webp`,
  description: t.metaHomeDesc,
  telephone: FIRM.phone,
  email: FIRM.email,
  priceRange: "350 € - 500 €",
  knowsLanguage: [...LOCALES],
  sameAs: FIRM.socials.map((s) => s.url),
  founder: [
    { "@type": "Person", name: "Mar Gámez", jobTitle: t.roleMarGamez },
    { "@type": "Person", name: "Mar Ramírez", jobTitle: t.roleMarRamirez },
  ],
  employee: FIRM.team.map((m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: t[m.roleKey],
  })),
  location: FIRM.offices.map((o) => ({
    "@type": "Place",
    name: `RRYP Global ${o.city}`,
    address: {
      "@type": "PostalAddress",
      streetAddress: o.street,
      postalCode: o.postalCode,
      addressLocality: o.city,
      addressCountry: "ES",
    },
  })),
  areaServed: ["España", "Madrid", "Málaga", "Marbella", "Costa del Sol", "Córdoba", ...t.crossborderCountries],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "09:00",
      closes: "14:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "16:00",
      closes: "19:15",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Friday"],
      opens: "08:00",
      closes: "15:00",
    },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.entryEyebrow,
    itemListElement: [
      {
        "@type": "Offer",
        name: `${t.e1Title} (${t.e1Dur})`,
        price: "0",
        priceCurrency: "EUR",
        url: FIRM.calendly.initial,
      },
      {
        "@type": "Offer",
        name: `${t.e2Title} (${t.e2Dur})`,
        price: "350",
        priceCurrency: "EUR",
        url: FIRM.calendly.legal,
      },
      {
        "@type": "Offer",
        name: `${t.e3Title} (${t.e3Dur})`,
        price: "500",
        priceCurrency: "EUR",
        url: FIRM.calendly.urgent,
      },
    ],
  },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${FIRM.siteUrl}/#website`,
  url: `${FIRM.siteUrl}/`,
  name: FIRM.brand,
  publisher: { "@id": `${FIRM.siteUrl}/#organization` },
  inLanguage: [...LOCALES],
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${FIRM.siteUrl}${localizedPath(lang, "legal-intelligence")}?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const graphNodes: Record<string, unknown>[] = [orgNode, websiteNode];

if (breadcrumbs && breadcrumbs.length > 0) {
  graphNodes.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      name: b.name,
      item: b.url ? (b.url.startsWith("http") ? b.url : `${FIRM.siteUrl}${b.url}`) : canonicalUrl,
    })),
  });
} else if (breadcrumbLabel) {
  graphNodes.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t.bcHome,
        item: `${FIRM.siteUrl}${localizedPath(lang)}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: breadcrumbLabel,
        item: canonicalUrl,
      },
    ],
  });
}

for (const extra of jsonLdExtra) {
  graphNodes.push(extra);
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graphNodes,
});

const hasLocalEntryRoutes =
  activeNav === "home" ||
  activeNav === "clients" ||
  activeNav === "wealth" ||
  activeNav === "disputes" ||
  activeNav === "cases" ||
  activeNav === "firm" ||
  cleanSlug === "madrid" ||
  cleanSlug === "malaga" ||
  cleanSlug === "cordoba" ||
  cleanSlug === "medios" ||
  cleanSlug === "historia" ||
  cleanSlug === "diccionario-juridico" ||
  cleanSlug === "rryp-en-5" ||
  cleanSlug === "equipo/mar-gamez" ||
  cleanSlug.startsWith("casos/") ||
  cleanSlug.startsWith("especialidades/") ||
  cleanSlug.startsWith("legal-intelligence/");

const entryHref =
  cleanSlug === "primera-reunion-juridica"
    ? "#reserva-rryp"
    : hasLocalEntryRoutes
      ? "#vias-de-entrada"
      : `${localizedPath(lang)}#vias-de-entrada`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#0E1211" />

    <link rel="icon" type="image/png" href="/assets/logos/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/logos/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="RRYP Legal Intelligence RSS" href="/rss.xml" />
    <link rel="canonical" href={canonicalUrl} />
    {validLocales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={`${FIRM.siteUrl}${localizedPath(loc, cleanSlug)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={FIRM.brand} />
    <meta property="og:locale" content={LOCALE_LABELS[lang].og} />
    {validLocales.filter((loc) => loc !== lang).map((loc) => (
      <meta property="og:locale:alternate" content={LOCALE_LABELS[loc].og} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RRYP Global International Legal Boutique" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/fraunces-latin-full-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadAvifSrcset ? (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={preloadAvifSrcset}
        imagesizes={preloadSizes}
        fetchpriority="high"
      />
    ) : (
      preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <script type="application/ld+json" set:html={jsonLd} />
    <script
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [
          {
            where: {
              and: [
                { href_matches: `/${lang}/*` },
                { not: { href_matches: "/api/*" } },
              ],
            },
            eagerness: "moderate",
          },
        ],
      })}
    />
  </head>
  <body data-locale={lang}>
    <a href="#inicio" class="skip-link">{t.skipLink}</a>

    <header class="site-header">
      <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
      <div class="container header-inner">
        <a href={localizedPath(lang)} class="brand-link" aria-label="RRYP Global">
          <img
            src="/assets/logos/rryp-logo-gold.webp?v=hd2"
            alt="RRYP Global International Legal Boutique"
            class="brand-logo"
            width="219"
            height="80"
          />
        </a>

        <nav class="main-nav" id="main-nav" aria-label={t.ariaMainNav}>
          <a
            href={localizedPath(lang, "private-clients")}
            data-astro-prefetch
            class={activeNav === "clients" ? "is-active" : undefined}
            aria-current={activeNav === "clients" ? "page" : undefined}
          >
            {t.navClients}
          </a>
          <a
            href={localizedPath(lang, "private-wealth")}
            data-astro-prefetch
            class={activeNav === "wealth" ? "is-active" : undefined}
            aria-current={activeNav === "wealth" ? "page" : undefined}
          >
            {t.navWealth}
          </a>
          <a
            href={localizedPath(lang, "business-disputes")}
            data-astro-prefetch
            class={activeNav === "disputes" ? "is-active" : undefined}
            aria-current={activeNav === "disputes" ? "page" : undefined}
          >
            {t.navDisputes}
          </a>
          <a
            href={localizedPath(lang, "casos")}
            data-astro-prefetch
            class={activeNav === "cases" ? "is-active" : undefined}
            aria-current={activeNav === "cases" ? "page" : undefined}
          >
            {t.navCases}
          </a>
          <a
            href={localizedPath(lang, "la-firma")}
            data-astro-prefetch
            class={activeNav === "firm" ? "is-active" : undefined}
            aria-current={activeNav === "firm" ? "page" : undefined}
          >
            {t.navFirmShort}
          </a>
          <a
            href={localizedPath(lang, "legal-intelligence")}
            data-astro-prefetch
            class={activeNav === "intel" ? "is-active" : undefined}
            aria-current={activeNav === "intel" ? "page" : undefined}
          >
            {t.navIntel}
          </a>

          <div class="nav-lang" id="nav-lang">
            <p class="nav-lang-mobile-label">{t.footerLangsHead}</p>
            <button
              type="button"
              class="nav-lang-toggle"
              id="nav-lang-toggle"
              aria-expanded="false"
              aria-controls="nav-lang-popover"
              aria-label={t.ariaLangSwitcher}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9.5" />
                <path d="M2.8 12h18.4M12 2.5a13.5 13.5 0 0 1 0 19M12 2.5a13.5 13.5 0 0 0 0 19" />
              </svg>
              <span>{LOCALE_LABELS[lang].code}</span>
              <span class="nav-lang-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-lang-popover" id="nav-lang-popover" role="group" aria-label={t.ariaLangSwitcher}>
              {LOCALES.map((loc) => (
                <a
                  href={langSwitchHref(loc)}
                  hreflang={loc}
                  data-set-lang={loc}
                  class={`nav-lang-option ${loc === lang ? "is-active" : ""}`}
                  aria-current={loc === lang ? "page" : undefined}
                >
                  <span class="nav-lang-code">{LOCALE_LABELS[loc].code}</span>
                  <span class="nav-lang-native">{LOCALE_LABELS[loc].native}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="mobile-nav-consult">
            <p class="consult-eyebrow">{t.mobileConsultLabel}</p>
            <div class="mobile-nav-consult-grid">
              <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime btn--compact">
                {t.e2Title} ({t.e2Fee})
              </a>
              <a href={FIRM.calendly.initial} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark btn--compact">
                {t.e1Title} ({t.e1Fee})
              </a>
              <a href={FIRM.calendly.urgent} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark btn--compact">
                {t.e3Title} ({t.e3Fee})
              </a>
            </div>
          </div>
        </nav>

        <div class="header-actions">
          <button
            type="button"
            class="header-search-btn"
            id="rryp-search-open"
            aria-label={t.searchOpenAria}
            title={t.searchOpenAria}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5" />
              <path d="m20 20-3.8-3.8" stroke-linecap="round" />
            </svg>
          </button>

          {urgentHeaderCta ? (
            <a
              href={FIRM.calendly.urgent}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--lime btn--compact header-cta"
            >
              {t.penalUrgentCta}
            </a>
          ) : (
            <div class="consult-menu" id="consult-menu">
              <button
                type="button"
                class="btn btn--lime btn--compact header-cta"
                id="consult-toggle"
                aria-expanded="false"
                aria-controls="consult-popover"
              >
                <span>{t.headerCta}</span>
                <span aria-hidden="true" style="font-size: 10px;">▾</span>
              </button>
              <div class="consult-popover" id="consult-popover" hidden>
                <p class="consult-eyebrow">{t.consultEyebrow}</p>
                <p class="consult-heading">{t.consultHeading}</p>
                <div class="consult-options">
                  <a href={FIRM.calendly.initial} target="_blank" rel="noopener noreferrer" class="consult-option">
                    <strong>{t.e1Title}</strong>
                    <span>{t.consultOpt1Meta}</span>
                  </a>
                  <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="consult-option consult-option--featured">
                    <strong>{t.e2Title}</strong>
                    <span>{t.consultOpt2Meta}</span>
                  </a>
                  <a href={FIRM.calendly.urgent} target="_blank" rel="noopener noreferrer" class="consult-option">
                    <strong>{t.e3Title}</strong>
                    <span>{t.consultOpt3Meta}</span>
                  </a>
                </div>
                <p class="consult-footer-note">{t.consultFooterNote}</p>
                <p
                  class="office-live-status"
                  data-office-status
                  data-open={t.statusOpenNow}
                  data-closed={t.statusClosedNow}
                  aria-live="polite"
                ></p>
              </div>
            </div>
          )}

          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="main-nav"
          >
            {t.menuLabel}
          </button>
        </div>
      </div>
    </header>

    <main id="inicio">
      <slot />
    </main>

    <footer class="site-footer" id="contacto-pie">
      <div class="container">
        {fullFooter && (
          <div class="footer-intake" data-reveal>
            <div>
              <p class="eyebrow">RRYP Global</p>
              <h2 class="footer-intake-title">{t.footerIntakeTitle}</h2>
              <p class="footer-intake-lead">{t.footerIntakeLead}</p>
              <div class="footer-direct-channels">
                <a
                  href={FIRM.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--outline-dark btn--compact"
                >
                  WhatsApp →
                </a>
                <a href={entryHref} class="btn btn--lime btn--compact">
                  {t.footerMatterCta}
                </a>
              </div>
              <div class="footer-socials" aria-label={t.ariaOfficialChannels}>
                {FIRM.socials.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label} ↗
                  </a>
                ))}
              </div>
            </div>

            <form
              class="footer-form"
              id="footer-intake-form"
              data-msg-error={t.formError}
              data-msg-email={t.formEmailInvalid}
              data-msg-success={t.formSuccess}
              data-msg-direct={t.formDirectSendNote}
              data-btn-email={t.formSendEmailBtn}
              data-btn-wa={t.formSendWaBtn}
              novalidate
            >
              <div class="footer-field">
                <label for="f-name">{t.formName}</label>
                <input id="f-name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class="footer-field">
                <label for="f-email">{t.formEmail}</label>
                <input id="f-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="footer-field">
                <label for="f-phone">{t.formPhone}</label>
                <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
              <div class="footer-field">
                <label for="f-country">{t.formCountry}</label>
                <input id="f-country" name="country" type="text" autocomplete="country-name" />
              </div>
              <div class="footer-field footer-field--full">
                <label for="f-message">{t.formMessage}</label>
                <textarea id="f-message" name="message" required></textarea>
              </div>
              <label class="footer-consent">
                <input type="checkbox" id="f-consent" required />
                <span set:html={t.formConsentHtml} />
              </label>
              <div class="footer-form-actions">
                <button type="submit" class="btn btn--lime btn--compact">
                  {t.formSubmit}
                </button>
                <p class="footer-form-feedback" id="footer-form-feedback" role="status" aria-live="polite"></p>
                <div class="footer-form-direct" id="footer-form-direct" hidden></div>
              </div>
            </form>
          </div>
        )}

        <div class="footer-directory">
          <div>
            <img
              loading="lazy"
              decoding="async"
              src="/assets/logos/rryp-logo-cream.webp?v=hd2"
              alt="RRYP Global"
              class="footer-logo"
              width="219"
              height="80"
            />
            <div class="footer-contact-stack">
              <a href={FIRM.emailHref}>{FIRM.email}</a>
              <a href={FIRM.phoneHref}>{FIRM.phone}</a>
            </div>
            <a href={entryHref} class="footer-cta-link">
              {t.footerMatterCta}
            </a>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerAreasHead}</h4>
            <ul class="footer-links">
              <li><a href={localizedPath(lang, "private-clients")}>Private Clients ↗</a></li>
              <li><a href={localizedPath(lang, "private-wealth")}>Private Wealth ↗</a></li>
              <li><a href={localizedPath(lang, "business-disputes")}>Business Disputes ↗</a></li>
              <li><a href={localizedPath(lang, "casos")}>{t.footerLinkCases}</a></li>
              <li><a href={localizedPath(lang, "la-firma")}>{t.footerLinkFirm}</a></li>
              <li><a href={localizedPath(lang, "historia")}>{t.footerLinkHist}</a></li>
              <li><a href={localizedPath(lang, "rryp-en-5")}>{t.footerLinkR5}</a></li>
              <li><a href={localizedPath(lang, "medios")}>{t.footerLinkMedios}</a></li>
              <li><a href={localizedPath(lang, "primera-reunion-juridica")}>{t.footerLinkMeet}</a></li>
              <li><a href={localizedPath(lang, "legal-intelligence")}>Legal Intelligence AI ↗</a></li>
              <li><a href={localizedPath(lang, "diccionario-juridico")}>{t.footerLinkDict}</a></li>
              <li><a href={localizedPath(lang, "penal-economico-extradicion")}>{t.footerLinkPenal}</a></li>
              <li>
                <a href={localizedPath(lang, "contacto")}>
                  {{ es: "Contacto →", en: "Contact →", de: "Kontakt →", pt: "Contacto →", ru: "Контакты →", zh: "联系我们 →" }[lang]}
                </a>
              </li>
              <li><a href={localizedPath(lang, "careers")}>Careers ↗</a></li>
            </ul>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerOfficesHead}</h4>
            <ul class="footer-offices">
              {FIRM.offices.map((office) => (
                <li>
                  <a href={localizedPath(lang, office.slug)}>
                    <strong>{office.city}</strong>
                    <span>{office.fullAddress}</span>
                    {office.hasServiceAreaNote && (
                      <span class="footer-office-area">{t.footerMalagaArea}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerLangsHead}</h4>
            <ul class="footer-links">
              {LOCALES.map((loc) => (
                <li>
                  <a href={langSwitchHref(loc)} hreflang={loc} data-set-lang={loc}>
                    /{loc}/ {LOCALE_LABELS[loc].native}
                    {loc === DEFAULT_LOCALE ? " (x-default)" : ""}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {fullFooter && (
          <div class="footer-crossborder">
            <p class="crossborder-label">Cross-border</p>
            <ul class="crossborder-list">
              {t.crossborderCountries.map((country) => (
                <li>{country}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="footer-bottom">
          <div>
            <span>© 2026 {FIRM.brand}, {FIRM.legalName}</span>
          </div>

          <div class="footer-legal-links">
            <a href={localizedPath(lang, "legal/aviso-legal")}>{t.legalNotice}</a>
            <a href={localizedPath(lang, "legal/condiciones")}>{t.legalTerms}</a>
            <a href={localizedPath(lang, "legal/cookies")}>{t.legalCookies}</a>
            <a href={localizedPath(lang, "legal/privacidad")}>{t.legalPrivacy}</a>
          </div>

          <div class="footer-bottom-right">
            <a href="#inicio" class="back-to-top" aria-label={t.ariaBackToTop}>↑</a>
          </div>
        </div>
      </div>
    </footer>

    <SiteWidgets lang={lang} />
    <CookieConsent lang={lang} />

    <script src="../scripts/site-core.ts"></script>
  </body>
</html>
