---
import "../styles/global.css";
import { FIRM } from "../data/firm";
import CookieConsent from "../components/CookieConsent.astro";
import SiteWidgets from "../components/SiteWidgets.astro";
import {
  DEFAULT_LOCALE,
  getDictionary,
  LOCALE_LABELS,
  LOCALES,
  localizedPath,
  type Locale,
} from "../i18n";

export interface Props {
  lang: Locale;
  slug?: string;
  title: string;
  description: string;
  ogImage?: string;
  preloadImage?: string;
  activeNav?: "clients" | "wealth" | "disputes" | "cases" | "firm" | "intel" | "home";
  urgentHeaderCta?: boolean;
  fullFooter?: boolean;
  noindex?: boolean;
  breadcrumbLabel?: string;
  jsonLdExtra?: Record<string, unknown>[];
}

const {
  lang,
  slug = "",
  title,
  description,
  ogImage = "/assets/photos/editorial-cordoba.webp",
  preloadImage,
  activeNav = "home",
  urgentHeaderCta = false,
  fullFooter = false,
  noindex = false,
  breadcrumbLabel,
  jsonLdExtra = [],
} = Astro.props;

const t = getDictionary(lang);
const cleanSlug = slug.replace(/^\/+|\/+$/g, "");
const currentPath = localizedPath(lang, cleanSlug);
const canonicalUrl = `${FIRM.siteUrl}${currentPath}`;
const xDefaultUrl = `${FIRM.siteUrl}${localizedPath(DEFAULT_LOCALE, cleanSlug)}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${FIRM.siteUrl}${ogImage}`;

const orgNode = {
  "@type": "LegalService",
  "@id": `${FIRM.siteUrl}/#organization`,
  name: FIRM.brand,
  legalName: FIRM.legalName,
  alternateName: "RRYP Global International Legal Boutique",
  url: `${FIRM.siteUrl}/`,
  logo: `${FIRM.siteUrl}/assets/logos/rryp-logo-gold.webp`,
  image: `${FIRM.siteUrl}/assets/photos/editorial-cordoba.webp`,
  description: t.metaHomeDesc,
  telephone: FIRM.phone,
  email: FIRM.email,
  priceRange: "350 € - 500 €",
  knowsLanguage: [...LOCALES],
  sameAs: FIRM.socials.map((s) => s.url),
  founder: [
    { "@type": "Person", name: "Mar Gámez", jobTitle: t.roleMarGamez },
    { "@type": "Person", name: "Mar Ramírez", jobTitle: t.roleMarRamirez },
  ],
  employee: FIRM.team.map((m) => ({
    "@type": "Person",
    name: m.name,
    jobTitle: t[m.roleKey],
  })),
  location: FIRM.offices.map((o) => ({
    "@type": "Place",
    name: `RRYP Global ${o.city}`,
    address: {
      "@type": "PostalAddress",
      streetAddress: o.street,
      postalCode: o.postalCode,
      addressLocality: o.city,
      addressCountry: "ES",
    },
  })),
  areaServed: ["España", "Madrid", "Málaga", "Marbella", "Costa del Sol", "Córdoba", ...t.crossborderCountries],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "09:00",
      closes: "14:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "16:00",
      closes: "19:15",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Friday"],
      opens: "08:00",
      closes: "15:00",
    },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: t.entryEyebrow,
    itemListElement: [
      {
        "@type": "Offer",
        name: `${t.e1Title} (${t.e1Dur})`,
        price: "0",
        priceCurrency: "EUR",
        url: FIRM.calendly.initial,
      },
      {
        "@type": "Offer",
        name: `${t.e2Title} (${t.e2Dur})`,
        price: "350",
        priceCurrency: "EUR",
        url: FIRM.calendly.legal,
      },
      {
        "@type": "Offer",
        name: `${t.e3Title} (${t.e3Dur})`,
        price: "500",
        priceCurrency: "EUR",
        url: FIRM.calendly.urgent,
      },
    ],
  },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": `${FIRM.siteUrl}/#website`,
  url: `${FIRM.siteUrl}/`,
  name: FIRM.brand,
  publisher: { "@id": `${FIRM.siteUrl}/#organization` },
  inLanguage: [...LOCALES],
};

const graphNodes: Record<string, unknown>[] = [orgNode, websiteNode];

if (breadcrumbLabel) {
  graphNodes.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: t.bcHome,
        item: `${FIRM.siteUrl}${localizedPath(lang)}`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: breadcrumbLabel,
        item: canonicalUrl,
      },
    ],
  });
}

for (const extra of jsonLdExtra) {
  graphNodes.push(extra);
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graphNodes,
});

const hasLocalEntryRoutes =
  activeNav === "home" ||
  activeNav === "clients" ||
  activeNav === "wealth" ||
  activeNav === "disputes" ||
  activeNav === "cases" ||
  activeNav === "firm" ||
  cleanSlug === "madrid" ||
  cleanSlug === "malaga" ||
  cleanSlug === "cordoba";

const entryHref = hasLocalEntryRoutes ? "#vias-de-entrada" : `${localizedPath(lang)}#vias-de-entrada`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#0E1211" />

    <link rel="icon" type="image/png" href="/assets/logos/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {LOCALES.map((loc) => (
      <link rel="alternate" hreflang={loc} href={`${FIRM.siteUrl}${localizedPath(loc, cleanSlug)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={FIRM.brand} />
    <meta property="og:locale" content={LOCALE_LABELS[lang].og} />
    {LOCALES.filter((loc) => loc !== lang).map((loc) => (
      <meta property="og:locale:alternate" content={LOCALE_LABELS[loc].og} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="RRYP Global International Legal Boutique" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preload" href="/assets/fonts/Fraunces.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/fonts/Inter.ttf" as="font" type="font/ttf" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body data-locale={lang}>
    <a href="#inicio" class="skip-link">{t.skipLink}</a>

    <header class="site-header">
      <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
      <div class="container header-inner">
        <a href={localizedPath(lang)} class="brand-link" aria-label="RRYP Global">
          <img
            src="/assets/logos/rryp-logo-gold.webp?v=hd2"
            alt="RRYP Global International Legal Boutique"
            class="brand-logo"
            width="219"
            height="80"
          />
        </a>

        <nav class="main-nav" id="main-nav" aria-label={t.ariaMainNav}>
          <a
            href={localizedPath(lang, "private-clients")}
            class={activeNav === "clients" ? "is-active" : undefined}
            aria-current={activeNav === "clients" ? "page" : undefined}
          >
            {t.navClients}
          </a>
          <a
            href={localizedPath(lang, "private-wealth")}
            class={activeNav === "wealth" ? "is-active" : undefined}
            aria-current={activeNav === "wealth" ? "page" : undefined}
          >
            {t.navWealth}
          </a>
          <a
            href={localizedPath(lang, "business-disputes")}
            class={activeNav === "disputes" ? "is-active" : undefined}
            aria-current={activeNav === "disputes" ? "page" : undefined}
          >
            {t.navDisputes}
          </a>
          <a
            href={localizedPath(lang, "casos")}
            class={activeNav === "cases" ? "is-active" : undefined}
            aria-current={activeNav === "cases" ? "page" : undefined}
          >
            {t.navCases}
          </a>
          <a
            href={localizedPath(lang, "la-firma")}
            class={activeNav === "firm" ? "is-active" : undefined}
            aria-current={activeNav === "firm" ? "page" : undefined}
          >
            {t.navFirmShort}
          </a>
          <a
            href={localizedPath(lang, "legal-intelligence")}
            class={activeNav === "intel" ? "is-active" : undefined}
            aria-current={activeNav === "intel" ? "page" : undefined}
          >
            {t.navIntel}
          </a>

          <div class="nav-lang" id="nav-lang">
            <p class="nav-lang-mobile-label">{t.footerLangsHead}</p>
            <button
              type="button"
              class="nav-lang-toggle"
              id="nav-lang-toggle"
              aria-expanded="false"
              aria-controls="nav-lang-popover"
              aria-label={t.ariaLangSwitcher}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9.5" />
                <path d="M2.8 12h18.4M12 2.5a13.5 13.5 0 0 1 0 19M12 2.5a13.5 13.5 0 0 0 0 19" />
              </svg>
              <span>{LOCALE_LABELS[lang].code}</span>
              <span class="nav-lang-caret" aria-hidden="true">▾</span>
            </button>
            <div class="nav-lang-popover" id="nav-lang-popover" role="group" aria-label={t.ariaLangSwitcher} hidden>
              {LOCALES.map((loc) => (
                <a
                  href={localizedPath(loc, cleanSlug)}
                  hreflang={loc}
                  data-set-lang={loc}
                  class={`nav-lang-option ${loc === lang ? "is-active" : ""}`}
                  aria-current={loc === lang ? "page" : undefined}
                >
                  <span class="nav-lang-code">{LOCALE_LABELS[loc].code}</span>
                  <span class="nav-lang-native">{LOCALE_LABELS[loc].native}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="mobile-nav-consult">
            <p class="consult-eyebrow">{t.mobileConsultLabel}</p>
            <div class="mobile-nav-consult-grid">
              <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="btn btn--lime btn--compact">
                {t.e2Title} ({t.e2Fee})
              </a>
              <a href={FIRM.calendly.initial} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark btn--compact">
                {t.e1Title} ({t.e1Fee})
              </a>
              <a href={FIRM.calendly.urgent} target="_blank" rel="noopener noreferrer" class="btn btn--outline-dark btn--compact">
                {t.e3Title} ({t.e3Fee})
              </a>
            </div>
          </div>
        </nav>

        <div class="header-actions">
          <button
            type="button"
            class="header-search-btn"
            id="rryp-search-open"
            aria-label={t.searchOpenAria}
            title={t.searchOpenAria}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5" />
              <path d="m20 20-3.8-3.8" stroke-linecap="round" />
            </svg>
          </button>

          {urgentHeaderCta ? (
            <a
              href={FIRM.calendly.urgent}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--lime btn--compact header-cta"
            >
              {t.penalUrgentCta}
            </a>
          ) : (
            <div class="consult-menu" id="consult-menu">
              <button
                type="button"
                class="btn btn--lime btn--compact header-cta"
                id="consult-toggle"
                aria-expanded="false"
                aria-controls="consult-popover"
              >
                <span>{t.headerCta}</span>
                <span aria-hidden="true" style="font-size: 10px;">▾</span>
              </button>
              <div class="consult-popover" id="consult-popover" hidden>
                <p class="consult-eyebrow">{t.consultEyebrow}</p>
                <p class="consult-heading">{t.consultHeading}</p>
                <div class="consult-options">
                  <a href={FIRM.calendly.initial} target="_blank" rel="noopener noreferrer" class="consult-option">
                    <strong>{t.e1Title}</strong>
                    <span>{t.consultOpt1Meta}</span>
                  </a>
                  <a href={FIRM.calendly.legal} target="_blank" rel="noopener noreferrer" class="consult-option consult-option--featured">
                    <strong>{t.e2Title}</strong>
                    <span>{t.consultOpt2Meta}</span>
                  </a>
                  <a href={FIRM.calendly.urgent} target="_blank" rel="noopener noreferrer" class="consult-option">
                    <strong>{t.e3Title}</strong>
                    <span>{t.consultOpt3Meta}</span>
                  </a>
                </div>
                <p class="consult-footer-note">{t.consultFooterNote}</p>
                <p
                  class="office-live-status"
                  data-office-status
                  data-open={t.statusOpenNow}
                  data-closed={t.statusClosedNow}
                  aria-live="polite"
                ></p>
              </div>
            </div>
          )}

          <button
            type="button"
            class="menu-toggle"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="main-nav"
          >
            {t.menuLabel}
          </button>
        </div>
      </div>
    </header>

    <main id="inicio">
      <slot />
    </main>

    <footer class="site-footer" id="contacto-pie">
      <div class="container">
        {fullFooter && (
          <div class="footer-intake" data-reveal>
            <div>
              <p class="eyebrow">RRYP Global</p>
              <h2 class="footer-intake-title">{t.footerIntakeTitle}</h2>
              <p class="footer-intake-lead">{t.footerIntakeLead}</p>
              <div class="footer-direct-channels">
                <a
                  href={FIRM.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn--outline-dark btn--compact"
                >
                  WhatsApp →
                </a>
                <a href={entryHref} class="btn btn--lime btn--compact">
                  {t.footerMatterCta}
                </a>
              </div>
              <div class="footer-socials" aria-label={t.ariaOfficialChannels}>
                {FIRM.socials.map((s) => (
                  <a href={s.url} target="_blank" rel="noopener noreferrer">
                    {s.label} ↗
                  </a>
                ))}
              </div>
            </div>

            <form
              class="footer-form"
              id="footer-intake-form"
              data-msg-error={t.formError}
              data-msg-email={t.formEmailInvalid}
              data-msg-success={t.formSuccess}
              data-msg-direct={t.formDirectSendNote}
              data-btn-email={t.formSendEmailBtn}
              data-btn-wa={t.formSendWaBtn}
              novalidate
            >
              <div class="footer-field">
                <label for="f-name">{t.formName}</label>
                <input id="f-name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class="footer-field">
                <label for="f-email">{t.formEmail}</label>
                <input id="f-email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="footer-field">
                <label for="f-phone">{t.formPhone}</label>
                <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
              </div>
              <div class="footer-field">
                <label for="f-country">{t.formCountry}</label>
                <input id="f-country" name="country" type="text" autocomplete="country-name" />
              </div>
              <div class="footer-field footer-field--full">
                <label for="f-message">{t.formMessage}</label>
                <textarea id="f-message" name="message" required></textarea>
              </div>
              <label class="footer-consent">
                <input type="checkbox" id="f-consent" required />
                <span set:html={t.formConsentHtml} />
              </label>
              <div class="footer-form-actions">
                <button type="submit" class="btn btn--lime btn--compact">
                  {t.formSubmit}
                </button>
                <p class="footer-form-feedback" id="footer-form-feedback" role="status" aria-live="polite"></p>
                <div class="footer-form-direct" id="footer-form-direct" hidden></div>
              </div>
            </form>
          </div>
        )}

        <div class="footer-directory">
          <div>
            <img
              loading="lazy"
              decoding="async"
              src="/assets/logos/rryp-logo-cream.webp?v=hd2"
              alt="RRYP Global"
              class="footer-logo"
              width="219"
              height="80"
            />
            <div class="footer-contact-stack">
              <a href={FIRM.emailHref}>{FIRM.email}</a>
              <a href={FIRM.phoneHref}>{FIRM.phone}</a>
            </div>
            <a href={entryHref} class="footer-cta-link">
              {t.footerMatterCta}
            </a>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerAreasHead}</h4>
            <ul class="footer-links">
              <li><a href={localizedPath(lang, "private-clients")}>Private Clients ↗</a></li>
              <li><a href={localizedPath(lang, "private-wealth")}>Private Wealth ↗</a></li>
              <li><a href={localizedPath(lang, "business-disputes")}>Business Disputes ↗</a></li>
              <li><a href={localizedPath(lang, "casos")}>{t.footerLinkCases}</a></li>
              <li><a href={localizedPath(lang, "la-firma")}>{t.footerLinkFirm}</a></li>
              <li><a href={localizedPath(lang, "legal-intelligence")}>Legal Intelligence AI ↗</a></li>
              <li><a href={localizedPath(lang, "penal-economico-extradicion")}>{t.footerLinkPenal}</a></li>
              <li><a href={localizedPath(lang, "careers")}>Careers ↗</a></li>
            </ul>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerOfficesHead}</h4>
            <ul class="footer-offices">
              {FIRM.offices.map((office) => (
                <li>
                  <a href={localizedPath(lang, office.slug)}>
                    <strong>{office.city}</strong>
                    <span>{office.fullAddress}</span>
                    {office.hasServiceAreaNote && (
                      <span class="footer-office-area">{t.footerMalagaArea}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="footer-heading">{t.footerLangsHead}</h4>
            <ul class="footer-links">
              {LOCALES.map((loc) => (
                <li>
                  <a href={localizedPath(loc, cleanSlug)} hreflang={loc} data-set-lang={loc}>
                    /{loc}/ {LOCALE_LABELS[loc].native}
                    {loc === DEFAULT_LOCALE ? " (x-default)" : ""}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {fullFooter && (
          <div class="footer-crossborder">
            <p class="crossborder-label">Cross-border</p>
            <ul class="crossborder-list">
              {t.crossborderCountries.map((country) => (
                <li>{country}</li>
              ))}
            </ul>
          </div>
        )}

        <div class="footer-bottom">
          <div>
            <span>© 2026 {FIRM.brand}, {FIRM.legalName}</span>
          </div>

          <div class="footer-legal-links">
            <a href={FIRM.legalLinks.notice} target="_blank" rel="noopener noreferrer">{t.legalNotice}</a>
            <a href={FIRM.legalLinks.terms} target="_blank" rel="noopener noreferrer">{t.legalTerms}</a>
            <a href={FIRM.legalLinks.cookies} target="_blank" rel="noopener noreferrer">{t.legalCookies}</a>
            <a href={FIRM.legalLinks.privacy} target="_blank" rel="noopener noreferrer">{t.legalPrivacy}</a>
          </div>

          <div class="footer-bottom-right">
            <a href="#inicio" class="back-to-top" aria-label={t.ariaBackToTop}>↑</a>
          </div>
        </div>
      </div>
    </footer>

    <SiteWidgets lang={lang} />
    <CookieConsent lang={lang} />

    <script is:inline>
      (function () {
        // Language selector dropdown inside main menu + consultation dropdown popover
        var langToggle = document.getElementById("nav-lang-toggle");
        var langPopover = document.getElementById("nav-lang-popover");
        var consultToggle = document.getElementById("consult-toggle");
        var consultPopover = document.getElementById("consult-popover");

        if (langToggle && langPopover) {
          langToggle.addEventListener("click", function (e) {
            e.stopPropagation();
            var open = langPopover.hidden;
            if (open && consultPopover && !consultPopover.hidden && consultToggle) {
              consultPopover.hidden = true;
              consultToggle.setAttribute("aria-expanded", "false");
            }
            langPopover.hidden = !open;
            langToggle.setAttribute("aria-expanded", String(open));
          });
          document.addEventListener("click", function (e) {
            if (!langPopover.hidden && !langPopover.contains(e.target) && !langToggle.contains(e.target)) {
              langPopover.hidden = true;
              langToggle.setAttribute("aria-expanded", "false");
            }
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !langPopover.hidden) {
              langPopover.hidden = true;
              langToggle.setAttribute("aria-expanded", "false");
              langToggle.focus();
            }
          });
        }

        if (consultToggle && consultPopover) {
          consultToggle.addEventListener("click", function (e) {
            if (consultToggle.getAttribute("data-urgent-direct") === "true") return;
            e.stopPropagation();
            var open = consultPopover.hidden;
            if (open && langPopover && !langPopover.hidden && langToggle) {
              langPopover.hidden = true;
              langToggle.setAttribute("aria-expanded", "false");
            }
            consultPopover.hidden = !open;
            consultToggle.setAttribute("aria-expanded", String(open));
          });
          document.addEventListener("click", function (e) {
            if (!consultPopover.hidden && !consultPopover.contains(e.target) && !consultToggle.contains(e.target)) {
              consultPopover.hidden = true;
              consultToggle.setAttribute("aria-expanded", "false");
            }
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !consultPopover.hidden) {
              consultPopover.hidden = true;
              consultToggle.setAttribute("aria-expanded", "false");
            }
          });
        }

        // Persist explicit language choice in cookie for SEO-safe 302 middleware
        document.querySelectorAll("[data-set-lang]").forEach(function (link) {
          link.addEventListener("click", function () {
            var code = link.getAttribute("data-set-lang");
            if (code) {
              document.cookie = "rryp_lang=" + encodeURIComponent(code) + "; path=/; max-age=31536000; SameSite=Lax";
              try { localStorage.setItem("rryp_lang", code); } catch (_) {}
            }
          });
        });

        // Mobile menu toggle + close on Escape, link click, or outside tap
        var toggle = document.getElementById("menu-toggle");
        var nav = document.getElementById("main-nav");
        if (toggle && nav) {
          function closeMobileNav(restoreFocus) {
            toggle.setAttribute("aria-expanded", "false");
            nav.classList.remove("is-open");
            if (restoreFocus) toggle.focus();
          }
          toggle.addEventListener("click", function (e) {
            e.stopPropagation();
            var expanded = toggle.getAttribute("aria-expanded") === "true";
            toggle.setAttribute("aria-expanded", String(!expanded));
            nav.classList.toggle("is-open", !expanded);
          });
          nav.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
              if (nav.classList.contains("is-open")) closeMobileNav(false);
            });
          });
          document.addEventListener("click", function (e) {
            if (nav.classList.contains("is-open") && !nav.contains(e.target) && e.target !== toggle) {
              closeMobileNav(false);
            }
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && nav.classList.contains("is-open")) {
              closeMobileNav(true);
            }
          });
        }

        // Live office availability in Europe/Madrid timezone (real official schedule)
        var statusEls = document.querySelectorAll("[data-office-status]");
        if (statusEls.length) {
          function updateOfficeStatus() {
            var isOpen = false;
            try {
              var parts = new Intl.DateTimeFormat("en-GB", {
                timeZone: "Europe/Madrid",
                weekday: "short",
                hour: "2-digit",
                minute: "2-digit",
                hour12: false,
              }).formatToParts(new Date());
              var map = {};
              parts.forEach(function (p) { map[p.type] = p.value; });
              var day = map.weekday;
              var mins = parseInt(map.hour, 10) * 60 + parseInt(map.minute, 10);
              if (day === "Mon" || day === "Tue" || day === "Wed" || day === "Thu") {
                isOpen = (mins >= 540 && mins < 840) || (mins >= 960 && mins < 1155);
              } else if (day === "Fri") {
                isOpen = mins >= 480 && mins < 900;
              }
            } catch (_) {}
            statusEls.forEach(function (el) {
              el.classList.toggle("is-open", isOpen);
              el.classList.toggle("is-closed", !isOpen);
              el.textContent = isOpen
                ? el.getAttribute("data-open") || ""
                : el.getAttribute("data-closed") || "";
            });
          }
          updateOfficeStatus();
          window.setInterval(updateOfficeStatus, 60000);
        }

        // Scroll-aware header border & GPU reading progress hairline (0 layout thrashing)
        var progressBar = document.getElementById("scroll-progress");
        var ticking = false;
        var cachedDocH = 1;
        var lastScrolled = false;
        function measureDoc() {
          cachedDocH = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        }
        function updateScroll() {
          ticking = false;
          var y = window.scrollY || window.pageYOffset || 0;
          var scrolled = y > 24;
          if (scrolled !== lastScrolled) {
            lastScrolled = scrolled;
            document.documentElement.classList.toggle("is-scrolled", scrolled);
          }
          if (progressBar) {
            var pct = Math.min(1, Math.max(0, y / cachedDocH));
            progressBar.style.transform = "scaleX(" + pct.toFixed(4) + ") translateZ(0)";
          }
        }
        measureDoc();
        window.addEventListener("load", function () { measureDoc(); updateScroll(); }, { passive: true });
        window.addEventListener("resize", function () { measureDoc(); updateScroll(); }, { passive: true });
        window.addEventListener("scroll", function () {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateScroll);
          }
        }, { passive: true });
        updateScroll();

        // Scroll reveals honoring prefers-reduced-motion; remove data-reveal after settle so hover has 0ms delay and native 220ms transition
        var reveals = document.querySelectorAll("[data-reveal]");
        if (reveals.length) {
          var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduced || !("IntersectionObserver" in window)) {
            reveals.forEach(function (el) { el.removeAttribute("data-reveal"); });
          } else {
            document.documentElement.classList.add("js-enhanced");
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var target = entry.target;
                  target.classList.add("is-visible");
                  io.unobserve(target);
                  window.setTimeout(function () {
                    target.removeAttribute("data-reveal");
                    target.classList.remove("is-visible");
                  }, 700);
                }
              });
            }, { threshold: 0.05, rootMargin: "0px 0px -12px 0px" });
            reveals.forEach(function (el) { io.observe(el); });
          }
        }

        // Consultation intake form validation + 1-click direct channel dispatch (email / WhatsApp)
        var form = document.getElementById("footer-intake-form");
        var fb = document.getElementById("footer-form-feedback");
        var directBox = document.getElementById("footer-form-direct");
        if (form && fb) {
          var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          form.addEventListener("submit", function (e) {
            e.preventDefault();
            var name = document.getElementById("f-name");
            var email = document.getElementById("f-email");
            var phone = document.getElementById("f-phone");
            var country = document.getElementById("f-country");
            var msg = document.getElementById("f-message");
            var consent = document.getElementById("f-consent");
            var requiredEls = [name, email, msg, consent];
            requiredEls.forEach(function (el) { if (el) el.removeAttribute("aria-invalid"); });
            if (directBox) directBox.hidden = true;

            if (!name.value.trim() || !email.value.trim() || !msg.value.trim() || !consent.checked) {
              var firstBad = null;
              if (!name.value.trim()) { name.setAttribute("aria-invalid", "true"); firstBad = firstBad || name; }
              if (!email.value.trim()) { email.setAttribute("aria-invalid", "true"); firstBad = firstBad || email; }
              if (!msg.value.trim()) { msg.setAttribute("aria-invalid", "true"); firstBad = firstBad || msg; }
              if (!consent.checked) { consent.setAttribute("aria-invalid", "true"); firstBad = firstBad || consent; }
              fb.textContent = form.getAttribute("data-msg-error") || "";
              if (firstBad) firstBad.focus();
              return;
            }
            if (!emailRe.test(email.value.trim())) {
              email.setAttribute("aria-invalid", "true");
              fb.textContent = form.getAttribute("data-msg-email") || form.getAttribute("data-msg-error") || "";
              email.focus();
              return;
            }

            var summary = [
              "RRYP Global Inquiry",
              "Name: " + name.value.trim(),
              "Email: " + email.value.trim(),
              phone && phone.value.trim() ? "Phone: " + phone.value.trim() : "",
              country && country.value.trim() ? "Country: " + country.value.trim() : "",
              "",
              msg.value.trim(),
            ].filter(Boolean).join("\n");

            fb.textContent = form.getAttribute("data-msg-success") || "";
            if (directBox) {
              var mailHref =
                "mailto:info@rrypglobal.com?subject=" +
                encodeURIComponent("Consulta jurídica RRYP Global - " + name.value.trim()) +
                "&body=" +
                encodeURIComponent(summary);
              var waHref = "https://wa.me/34957858952?text=" + encodeURIComponent(summary);
              directBox.innerHTML = "";
              var note = document.createElement("p");
              note.className = "footer-form-direct-note";
              note.textContent = form.getAttribute("data-msg-direct") || "";
              var links = document.createElement("div");
              links.className = "footer-form-direct-links";
              var aMail = document.createElement("a");
              aMail.href = mailHref;
              aMail.className = "btn btn--outline-dark btn--compact";
              aMail.textContent = form.getAttribute("data-btn-email") || "Email";
              var aWa = document.createElement("a");
              aWa.href = waHref;
              aWa.target = "_blank";
              aWa.rel = "noopener noreferrer";
              aWa.className = "btn btn--outline-dark btn--compact";
              aWa.textContent = form.getAttribute("data-btn-wa") || "WhatsApp";
              links.appendChild(aMail);
              links.appendChild(aWa);
              directBox.appendChild(note);
              directBox.appendChild(links);
              directBox.hidden = false;
            }
            form.reset();
          });
        }
      })();
    </script>
  </body>
</html>
