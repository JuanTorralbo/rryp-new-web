const c = COPY[lang];

const channels = [
  {
    id: "linkedin",
    handle: "company/rryp-abogados",
    url: FIRM.socials[0].url,
    ...c.linkedin,
  },
  {
    id: "youtube",
    handle: "@RRYPGlobal_PodcastAbogados",
    url: FIRM.socials[2].url,
    ...c.youtube,
  },
  {
    id: "substack",
    handle: "relacionateypunto.substack.com",
    url: FIRM.socials[3].url,
    ...c.substack,
  },
  {
    id: "instagram",
    handle: "@rrypglobal_abogados",
    url: FIRM.socials[1].url,
    ...c.instagram,
  },
] as const;

const isDark = surface === "dark";
---

<section class={isDark ? "section-dark eco-section" : "section-cream section-cream--bordered eco-section eco-section--cream"}>
  <div class="container">
    <div class="section-header" data-reveal>
      <div>
        <p class={isDark ? "eyebrow" : "eyebrow eyebrow--on-cream"}>{c.eyebrow}</p>
        <h2 class="section-title">{c.title}</h2>
      </div>
      <p class="section-intro">{c.lead}</p>
    </div>

    <div class="eco-grid" data-reveal>
      {channels.map((ch) => (
        <a
          href={ch.url}
          target="_blank"
          rel="noopener noreferrer"
          class={isDark ? "eco-card" : "eco-card eco-card--cream"}
        >
          <div>
            <div class="eco-card-top">
              <span class="eco-icon" aria-hidden="true">
                {ch.id === "linkedin" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M6.94 8.5H3.56V19.5H6.94V8.5ZM5.25 3.5C4.14 3.5 3.25 4.39 3.25 5.5C3.25 6.6 4.14 7.5 5.25 7.5C6.35 7.5 7.25 6.6 7.25 5.5C7.25 4.39 6.35 3.5 5.25 3.5ZM20.44 13.02C20.44 9.88 18.76 8.22 16.16 8.22C14.37 8.22 13.48 9.21 13.02 9.93V8.5H9.65C9.7 9.48 9.65 19.5 9.65 19.5H13.02V13.36C13.02 13.03 13.05 12.7 13.15 12.46C13.42 11.8 14.03 11.12 15.07 11.12C16.41 11.12 17.06 12.14 17.06 13.63V19.5H20.44V13.02Z" />
                  </svg>
                )}
                {ch.id === "youtube" && (
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2C2 9 2 12 2 12s0 3 .4 4.8a2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2c.4-1.8.4-4.8.4-4.8s0-3-.4-4.8ZM10 15.2V8.8L15.4 12 10 15.2Z" />
                  </svg>
                )}
                {ch.id === "substack" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4 4h16v2.6H4V4Zm0 4.8h16v2.6H4V8.8Zm0 4.8h16V21l-8-4.5L4 21v-7.4Z" />
                  </svg>
                )}
                {ch.id === "instagram" && (
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </span>
              <span class="eco-tag">{ch.tag}</span>
            </div>

            <h3 class="eco-card-title">{ch.title}</h3>
            <p class="eco-card-handle">{ch.handle}</p>
            <p class="eco-card-desc">{ch.desc}</p>
          </div>

          <span class="eco-card-cta">{ch.cta}</span>
        </a>
      ))}
    </div>

    <div class={isDark ? "eco-strip" : "eco-strip eco-strip--cream"} data-reveal>
      <span class="eco-strip-label">{c.stripLabel}</span>
      <div class="eco-strip-links">
        <a href="/rss.xml" class="eco-strip-link">
          RSS — {c.rssLabel} ↗
        </a>
        <a href={localizedPath(lang, "medios")} class="eco-strip-link">
          {c.mediaLabel} →
        </a>
        <a href={FIRM.whatsappUrl} target="_blank" rel="noopener noreferrer" class="eco-strip-link">
          {c.waLabel} ({FIRM.phone}) ↗
        </a>
      </div>
    </div>
  </div>
</section>
