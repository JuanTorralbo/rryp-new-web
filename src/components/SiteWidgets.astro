---
import { FIRM } from "../data/firm";
import { getDictionary, localizedPath, type Locale } from "../i18n";

export interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

const searchPages = [
  { title: t.navClients, desc: t.p1Desc, url: localizedPath(lang, "private-clients") },
  { title: t.navWealth, desc: t.p2Desc, url: localizedPath(lang, "private-wealth") },
  { title: t.navDisputes, desc: t.p3Desc, url: localizedPath(lang, "business-disputes") },
  { title: t.bcPenal, desc: t.penalHeroLead, url: localizedPath(lang, "penal-economico-extradicion") },
  { title: t.navCases, desc: t.casosHeroLead, url: localizedPath(lang, "casos") },
  { title: t.navFirmShort, desc: t.firmHeroLead, url: localizedPath(lang, "la-firma") },
  { title: "RRYP Legal Intelligence AI", desc: t.liHeroLead, url: localizedPath(lang, "legal-intelligence") },
  { title: "Madrid", desc: t.madridLead, url: localizedPath(lang, "madrid") },
  { title: "Málaga", desc: t.malagaLead, url: localizedPath(lang, "malaga") },
  { title: "Córdoba", desc: t.cordobaLead, url: localizedPath(lang, "cordoba") },
  { title: "Careers", desc: t.careersHeroLead, url: localizedPath(lang, "careers") },
];

const searchConfig = JSON.stringify({
  feedUrl: `/data/blog-${lang}.json`,
  pages: searchPages,
  pagesLabel: t.searchPagesGroup,
  articlesLabel: t.searchArticlesGroup,
  emptyLabel: t.searchEmpty,
});
---

<!-- Widget 1: Pastilla flotante WhatsApp abajo a la izquierda (igual que rrypglobal.com) -->
<a
  href={FIRM.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="rryp-whatsapp-fixed"
  aria-label={t.waAria}
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20.5 11.8A8.5 8.5 0 0 1 7.9 19.3L3.5 20.5l1.2-4.3A8.5 8.5 0 1 1 20.5 11.8Z"
      stroke="currentColor"
      stroke-width="1.9"
      stroke-linejoin="round"
    />
    <path
      d="M9.4 8.9c-.2-.4-.4-.4-.7-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.1s.9 2.5 1 2.6c.1.2 1.8 2.8 4.4 3.8 2.2.9 2.6.7 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.6-.3l-1.7-.8c-.2-.1-.4-.1-.6.1-.2.3-.7.8-.8 1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.7-1.7Z"
      fill="currentColor"
    />
  </svg>
  <span>{t.waPill}</span>
</a>

<!-- Widget 2: Dock vertical de redes sociales en borde derecho (igual que rrypglobal.com) -->
<aside class="rryp-social-rail" aria-label={t.socialRailAria}>
  <a
    href={FIRM.socials[0].url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="RRYP Global LinkedIn"
    title="LinkedIn"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.94 8.5H3.56V19.5H6.94V8.5ZM5.25 3.5C4.14 3.5 3.25 4.39 3.25 5.5C3.25 6.6 4.14 7.5 5.25 7.5C6.35 7.5 7.25 6.6 7.25 5.5C7.25 4.39 6.35 3.5 5.25 3.5ZM20.44 13.02C20.44 9.88 18.76 8.22 16.16 8.22C14.37 8.22 13.48 9.21 13.02 9.93V8.5H9.65C9.7 9.48 9.65 19.5 9.65 19.5H13.02V13.36C13.02 13.03 13.05 12.7 13.15 12.46C13.42 11.8 14.03 11.12 15.07 11.12C16.41 11.12 17.06 12.14 17.06 13.63V19.5H20.44V13.02Z" />
    </svg>
  </a>
  <a
    href={FIRM.socials[1].url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="RRYP Global Instagram"
    title="Instagram"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <a
    href={FIRM.socials[2].url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="RRYP Global YouTube"
    title="YouTube"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2C2 9 2 12 2 12s0 3 .4 4.8a2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2c.4-1.8.4-4.8.4-4.8s0-3-.4-4.8ZM10 15.2V8.8L15.4 12 10 15.2Z" />
    </svg>
  </a>
  <a
    href={FIRM.socials[3].url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="RRYP Global Substack"
    title="Substack"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M4 4h16v2.6H4V4Zm0 4.8h16v2.6H4V8.8Zm0 4.8h16V21l-8-4.5L4 21v-7.4Z" />
    </svg>
  </a>
</aside>

<!-- Widget 3: Overlay global de busqueda RRYP / SEARCH (igual que rrypglobal.com) -->
<div class="search-overlay" id="rryp-search-overlay" hidden>
  <div class="search-modal" role="dialog" aria-modal="true" aria-labelledby="rryp-search-title">
    <div class="search-modal-top">
      <span class="eyebrow" style="margin: 0;">{t.searchEyebrow}</span>
      <button type="button" class="search-close-btn" id="rryp-search-close">
        {t.searchClose} ×
      </button>
    </div>

    <h2 class="search-modal-title" id="rryp-search-title">{t.searchTitle}</h2>

    <div class="search-input-wrap">
      <input
        type="search"
        id="rryp-search-input"
        class="search-modal-input"
        placeholder={t.searchPlaceholder}
        autocomplete="off"
      />
    </div>
    <p class="search-modal-hint">
      <span>{t.searchHint}</span>
      <span class="search-shortcut-hint">{t.searchShortcutHint}</span>
    </p>

    <div class="search-results" id="rryp-search-results" aria-live="polite"></div>
  </div>
</div>

<script id="rryp-search-config" type="application/json" set:html={searchConfig} />

<script is:inline>
  (function () {
    var overlay = document.getElementById("rryp-search-overlay");
    var openBtn = document.getElementById("rryp-search-open");
    var closeBtn = document.getElementById("rryp-search-close");
    var input = document.getElementById("rryp-search-input");
    var resultsEl = document.getElementById("rryp-search-results");
    var cfgEl = document.getElementById("rryp-search-config");
    if (!overlay || !input || !resultsEl || !cfgEl) return;

    var cfg = JSON.parse(cfgEl.textContent || "{}");
    var articles = [];
    var loaded = false;

    function esc(s) {
      return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function ensureArticles() {
      if (loaded) return;
      loaded = true;
      fetch(cfg.feedUrl)
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (data) {
          if (Array.isArray(data)) {
            articles = data;
            render(input.value);
          }
        })
        .catch(function () {});
    }

    function norm(s) {
      return String(s || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function render(query) {
      var q = norm(String(query || "").trim());
      var matchedPages = (cfg.pages || []).filter(function (p) {
        if (!q) return true;
        return norm(p.title + " " + p.desc).includes(q);
      }).slice(0, q ? 6 : 5);

      var matchedArticles = q
        ? articles.filter(function (a) {
            return norm(a.title + " " + a.excerpt + " " + a.category).includes(q);
          }).slice(0, 6)
        : articles.slice(0, 4);

      if (!matchedPages.length && !matchedArticles.length) {
        resultsEl.innerHTML = '<p class="search-empty">' + esc(cfg.emptyLabel) + "</p>";
        return;
      }

      var html = "";
      if (matchedPages.length) {
        html += '<div class="search-group"><p class="search-group-label">' + esc(cfg.pagesLabel) + '</p><ul class="search-list">';
        matchedPages.forEach(function (p) {
          html +=
            '<li><a href="' + esc(p.url) + '"><strong>' + esc(p.title) + "</strong><span>" + esc(p.desc) + "</span></a></li>";
        });
        html += "</ul></div>";
      }
      if (matchedArticles.length) {
        html += '<div class="search-group"><p class="search-group-label">' + esc(cfg.articlesLabel) + '</p><ul class="search-list">';
        matchedArticles.forEach(function (a) {
          html +=
            '<li><a href="' +
            esc(a.url) +
            '" target="_blank" rel="noopener noreferrer"><strong>' +
            esc(a.title) +
            " ↗</strong><span>" +
            esc(a.date) +
            "</span></a></li>";
        });
        html += "</ul></div>";
      }
      resultsEl.innerHTML = html;
    }

    var lastTrigger = null;

    function openSearch(triggerEl) {
      lastTrigger = triggerEl || document.activeElement;
      overlay.hidden = false;
      document.body.style.overflow = "hidden";
      ensureArticles();
      render(input.value);
      window.setTimeout(function () { input.focus(); }, 30);
    }

    function closeSearch(restoreFocus) {
      overlay.hidden = true;
      document.body.style.overflow = "";
      if (restoreFocus && lastTrigger && typeof lastTrigger.focus === "function") {
        lastTrigger.focus();
      }
    }

    window.RRYP_OPEN_SEARCH = function () {
      openSearch(openBtn);
    };

    if (openBtn) {
      openBtn.addEventListener("click", function () {
        openSearch(openBtn);
      });
    }
    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        closeSearch(true);
      });
    }
    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) closeSearch(true);
    });
    document.addEventListener("keydown", function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (overlay.hidden) openSearch(openBtn);
        else closeSearch(true);
        return;
      }
      if (e.key === "Escape" && !overlay.hidden) {
        closeSearch(true);
      }
    });
    input.addEventListener("input", function () {
      render(input.value);
    });
  })();
</script>
